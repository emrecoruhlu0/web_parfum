generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  passwordHash String
  bio          String?
  avatar       String?
  createdAt    DateTime @default(now())

  collections         Collection[]
  dailyLogs           DailyLog[]
  reviews             Review[]
  likes               Like[]
  following           Follow[]       @relation("follower")
  followers           Follow[]       @relation("following")
  notifications       Notification[] @relation("recipient")
  sentNotifications   Notification[] @relation("actor")
  communityMemberships CommunityMember[]
  ownedCommunities    Community[]
  communityPosts      CommunityPost[]
  sentMessages        Message[]      @relation("sender")
  receivedMessages    Message[]      @relation("recipient")
}

model Perfume {
  id          Int      @id @default(autoincrement())
  name        String
  brand       String
  country     String?
  gender      String?
  year        Int?
  ratingValue Float?
  ratingCount Int?
  topNotes    String?
  middleNotes String?
  baseNotes   String?
  accord1     String?
  accord2     String?
  accord3     String?
  accord4     String?
  accord5     String?
  imageUrl    String?
  createdAt   DateTime @default(now())

  collections    Collection[]
  dailyLogs      DailyLog[]
  reviews        Review[]
  likes          Like[]
  communityPosts CommunityPost[]
}

model Collection {
  id          Int      @id @default(autoincrement())
  userId      Int
  perfumeId   Int
  status      String   // owned | wishlist | tried
  bottleLevel Int?     // 0-100 (%)
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  perfume Perfume @relation(fields: [perfumeId], references: [id])

  @@unique([userId, perfumeId])
}

model DailyLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  perfumeId Int
  date      DateTime
  note      String?
  sprays    Int?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  perfume Perfume @relation(fields: [perfumeId], references: [id])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  perfumeId Int
  rating    Int      // 1-5
  body      String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  perfume Perfume @relation(fields: [perfumeId], references: [id])

  @@unique([userId, perfumeId])
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  perfumeId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  perfume Perfume @relation(fields: [perfumeId], references: [id])

  @@unique([userId, perfumeId])
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id])
  following User @relation("following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

// type: like | follow | review | community_invite
model Notification {
  id          Int      @id @default(autoincrement())
  recipientId Int
  actorId     Int
  type        String
  perfumeId   Int?
  communityId Int?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient User     @relation("recipient", fields: [recipientId], references: [id])
  actor     User     @relation("actor", fields: [actorId], references: [id])
}

model Community {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  ownerId     Int
  imageUrl    String?
  createdAt   DateTime @default(now())

  owner   User              @relation(fields: [ownerId], references: [id])
  members CommunityMember[]
  posts   CommunityPost[]
}

model CommunityPost {
  id          Int      @id @default(autoincrement())
  communityId Int
  userId      Int
  body        String
  perfumeId   Int?
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  perfume   Perfume?  @relation(fields: [perfumeId], references: [id])
}

model CommunityMember {
  id          Int      @id @default(autoincrement())
  userId      Int
  communityId Int
  role        String   @default("member") // member | admin
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  community Community @relation(fields: [communityId], references: [id])

  @@unique([userId, communityId])
}

model Message {
  id          Int      @id @default(autoincrement())
  senderId    Int
  recipientId Int
  body        String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender    User @relation("sender", fields: [senderId], references: [id])
  recipient User @relation("recipient", fields: [recipientId], references: [id])
}
