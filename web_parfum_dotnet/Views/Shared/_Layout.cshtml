<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Koku.</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light-parfum">

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="d-flex" style="min-height:100vh">
        <!-- Sidebar -->
        <nav class="sidebar d-flex flex-column p-3" style="width:240px;min-height:100vh;background:#1a1a2e;color:#e0e0e0;position:fixed;top:0;left:0;z-index:100;">
            <a class="navbar-brand text-white fw-bold fs-4 mb-4 font-serif text-decoration-none" asp-controller="Feed" asp-action="Index">
                Koku.
            </a>
            <ul class="nav flex-column gap-1 flex-grow-1">
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewData["ActivePage"]?.ToString() == "Feed" ? "active" : "")"
                       asp-controller="Feed" asp-action="Index">
                        <i class="bi bi-house-door me-2"></i> Ana Akış
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewData["ActivePage"]?.ToString() == "Discover" ? "active" : "")"
                       asp-controller="Perfumes" asp-action="Index">
                        <i class="bi bi-search me-2"></i> Keşfet
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewData["ActivePage"]?.ToString() == "Collection" ? "active" : "")"
                       asp-controller="Collection" asp-action="Index">
                        <i class="bi bi-collection me-2"></i> Koleksiyon
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewData["ActivePage"]?.ToString() == "DailyLog" ? "active" : "")"
                       asp-controller="DailyLog" asp-action="Index">
                        <i class="bi bi-calendar3 me-2"></i> Günlük Log
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewData["ActivePage"]?.ToString() == "Communities" ? "active" : "")"
                       asp-controller="Communities" asp-action="Index">
                        <i class="bi bi-people me-2"></i> Topluluklar
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewData["ActivePage"]?.ToString() == "Messages" ? "active" : "")"
                       asp-controller="Messages" asp-action="Index">
                        <i class="bi bi-chat-dots me-2"></i> Mesajlar
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link position-relative @(ViewData["ActivePage"]?.ToString() == "Notifications" ? "active" : "")"
                       asp-controller="Notifications" asp-action="Index">
                        <i class="bi bi-bell me-2"></i> Bildirimler
                        @if (ViewData["UnreadCount"] is int count && count > 0)
                        {
                            <span class="badge bg-danger rounded-pill position-absolute top-50 end-0 translate-middle-y me-2">@count</span>
                        }
                    </a>
                </li>
            </ul>
            <div class="mt-auto pt-3 border-top border-secondary">
                <a class="nav-link sidebar-link @(ViewData["ActivePage"]?.ToString() == "Profile" ? "active" : "")"
                   asp-controller="Profile" asp-action="Index">
                    <i class="bi bi-person-circle me-2"></i> @User.Identity.Name
                </a>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100">
                        <i class="bi bi-box-arrow-left me-1"></i> Çıkış
                    </button>
                </form>
            </div>
        </nav>

        <!-- Main content -->
        <main class="flex-grow-1 p-4" style="margin-left:240px;">
            @RenderBody()
        </main>
    </div>
}
else
{
    <main>
        @RenderBody()
    </main>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
