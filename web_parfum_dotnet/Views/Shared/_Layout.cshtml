<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Koku.</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Figtree:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="~/css/koku.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var sillageColor = ViewData["SillageColor"]?.ToString() ?? "#5C3D2E";
}
<body class="bg-light-parfum" style="--koku-sillage: @sillageColor">

@if (User.Identity?.IsAuthenticated == true)
{
    <header class="mobile-topbar">
        <button type="button" id="sidebarToggle" aria-label="Menü">
            <i class="bi bi-list"></i>
        </button>
        <span class="brand">Koku.</span>
        @if (ViewData["UnreadCount"] is int unread && unread > 0)
        {
            <a asp-controller="Notifications" asp-action="Index" class="ms-auto notif-link text-decoration-none position-relative">
                <i class="bi bi-bell"></i>
                <span class="badge rounded-pill position-absolute top-0 start-100 translate-middle"
                      style="font-size:.6rem;background:var(--koku-danger)">@unread</span>
            </a>
        }
    </header>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <div class="d-flex" style="min-height:100vh">
        <nav class="sidebar" id="sidebarNav">
            <a class="sidebar-brand" asp-controller="Feed" asp-action="Index">Koku.</a>
            <ul class="nav flex-column gap-1 flex-grow-1">
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewData["ActivePage"]?.ToString() == "Feed" ? "active" : "")"
                       asp-controller="Feed" asp-action="Index">
                        <i class="bi bi-house-door me-2"></i> Ana Akış
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewData["ActivePage"]?.ToString() == "Discover" ? "active" : "")"
                       asp-controller="Perfumes" asp-action="Index">
                        <i class="bi bi-search me-2"></i> Keşfet
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewData["ActivePage"]?.ToString() == "Collection" ? "active" : "")"
                       asp-controller="Collection" asp-action="Index">
                        <i class="bi bi-collection me-2"></i> Koleksiyon
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewData["ActivePage"]?.ToString() == "DailyLog" ? "active" : "")"
                       asp-controller="DailyLog" asp-action="Index">
                        <i class="bi bi-calendar3 me-2"></i> Günlük Log
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewData["ActivePage"]?.ToString() == "Communities" ? "active" : "")"
                       asp-controller="Communities" asp-action="Index">
                        <i class="bi bi-people me-2"></i> Topluluklar
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewData["ActivePage"]?.ToString() == "Messages" ? "active" : "")"
                       asp-controller="Messages" asp-action="Index">
                        <i class="bi bi-chat-dots me-2"></i> Mesajlar
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link position-relative @(ViewData["ActivePage"]?.ToString() == "Notifications" ? "active" : "")"
                       asp-controller="Notifications" asp-action="Index">
                        <i class="bi bi-bell me-2"></i> Bildirimler
                        @if (ViewData["UnreadCount"] is int count && count > 0)
                        {
                            <span class="badge rounded-pill position-absolute top-50 end-0 translate-middle-y me-2"
                                  style="background:var(--koku-danger)">@count</span>
                        }
                    </a>
                </li>
            </ul>
            <div class="sidebar-footer">
                <a class="nav-link sidebar-link @(ViewData["ActivePage"]?.ToString() == "Profile" ? "active" : "")"
                   asp-controller="Profile" asp-action="Index">
                    <i class="bi bi-person-circle me-2"></i> @User.Identity.Name
                </a>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100 sidebar-logout">
                        <i class="bi bi-box-arrow-left me-1"></i> Çıkış
                    </button>
                </form>
            </div>
        </nav>

        <main class="app-main">
            @RenderBody()
        </main>
    </div>
}
else
{
    <main>
        @RenderBody()
    </main>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/perfume-autocomplete.js" asp-append-version="true"></script>
@if (User.Identity?.IsAuthenticated == true)
{
    <script src="~/js/mobile-sidebar.js" asp-append-version="true"></script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
