@model ErrorViewModel
@{
    ViewData["Title"] = "Bir şeyler ters gitti";
}

@await Html.PartialAsync("_EmptyState", new EmptyStateViewModel {
    Icon = "bi-exclamation-triangle",
    Title = "Bir şeyler ters gitti",
    Description = "İsteğin işlenirken bir hata oluştu. Sayfayı yenile veya ana akışa dön.",
    ActionText = "Ana akışa dön",
    ActionController = "Feed",
    ActionName = "Index"
})

@if (Model.ShowRequestId)
{
    <p class="text-center text-koku-muted small mt-3 font-data">
        İstek kimliği: @Model.RequestId
    </p>
}
