@model WebParfum.ViewModels.CommunityIndexViewModel

@{
    ViewData["Title"] = "Topluluklar";
    ViewData["ActivePage"] = "Communities";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="font-display fs-3 mb-0">Topluluklar</h1>
    <a asp-action="Create" class="btn btn-koku btn-sm">
        <i class="bi bi-plus-lg me-1"></i> Yeni Topluluk
    </a>
</div>

@if (!Model.Communities.Any())
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel {
        Icon = "bi-people",
        Title = "Henüz topluluk yok",
        Description = "İlk topluluğu sen oluştur.",
        ActionText = "Topluluk oluştur",
        ActionController = "Communities",
        ActionName = "Create"
    })
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var item in Model.Communities)
        {
            <div class="col">
                <div class="parfum-card p-4 h-100 d-flex flex-column">
                    <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                        <div class="community-avatar flex-shrink-0">
                            @item.Community.Name.Substring(0, 1).ToUpper()
                        </div>
                        @if (item.IsMember)
                        {
                            <span class="badge bg-amber-soft text-amber">
                                <i class="bi bi-check-circle me-1"></i>Üyesin
                            </span>
                        }
                    </div>

                    <a asp-action="Details" asp-route-id="@item.Community.Id"
                       class="text-decoration-none text-dark">
                        <h6 class="fw-bold mb-1">@item.Community.Name</h6>
                    </a>

                    @if (!string.IsNullOrEmpty(item.Community.Description))
                    {
                        <p class="text-muted small mb-3 flex-grow-1" style="line-height:1.4">
                            @(item.Community.Description.Length > 100
                                ? item.Community.Description.Substring(0, 100) + "…"
                                : item.Community.Description)
                        </p>
                    }
                    else
                    {
                        <div class="flex-grow-1"></div>
                    }

                    <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top">
                        <span class="text-muted small">
                            <i class="bi bi-people me-1"></i>@item.MemberCount üye
                        </span>
                        <a asp-action="Details" asp-route-id="@item.Community.Id"
                           class="btn btn-sm @(item.IsMember ? "btn-outline-secondary" : "btn-amber")">
                            @(item.IsMember ? "Görüntüle" : "Katıl")
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
