@model WebParfum.ViewModels.CommunityCreateViewModel

@{
    ViewData["Title"] = "Yeni Topluluk";
    ViewData["ActivePage"] = "Communities";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h1 class="font-serif fs-3 mb-0">Yeni Topluluk Oluştur</h1>
        </div>

        <div class="parfum-card p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-medium">Topluluk Adı *</label>
                    <input asp-for="Name" class="form-control" placeholder="Örn: Oud Severler" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-medium">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="3"
                              placeholder="Topluluğun amacını kısaca açıkla…"></textarea>
                </div>

                <div class="mb-4">
                    <label asp-for="ImageUrl" class="form-label fw-medium">Kapak Görseli URL <span class="text-muted">(opsiyonel)</span></label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-amber flex-grow-1">
                        <i class="bi bi-check-lg me-1"></i> Oluştur
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
