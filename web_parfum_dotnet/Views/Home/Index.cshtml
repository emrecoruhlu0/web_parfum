@{
    ViewData["Title"] = "Koku. — Parfüm Platformu";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <script>window.location.href = '@Url.Action("Index", "Feed")';</script>
}
else
{
    <div class="auth-split">
        @await Html.PartialAsync("_AuthVisual")
        <div class="auth-split-form">
            <div class="auth-panel" style="max-width:480px">
                <h1 class="brand-sm mb-2">Hoş geldin</h1>
                <p class="text-koku-muted mb-4" style="line-height:1.55">
                    Parfümü notalarıyla konuş, günlük kokunu kaydet, koku profiline göre öneri al.
                </p>

                <div class="d-flex gap-3 flex-wrap mb-4">
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-koku px-4 py-2">
                        <i class="bi bi-person-plus me-2"></i>Ücretsiz kaydol
                    </a>
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-koku-ghost px-4 py-2">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Giriş yap
                    </a>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-sm-4">
                        <div class="p-3 rounded-3 h-100" style="background:var(--koku-paper-raised);border:1px solid var(--koku-mist)">
                            <i class="bi bi-collection fs-5 text-koku-accent mb-2 d-block"></i>
                            <div class="fw-semibold small mb-1">Koleksiyon</div>
                            <div class="small text-koku-muted">Parfümlerini takip et, şişe doluluk oranını kaydet.</div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-4">
                        <div class="p-3 rounded-3 h-100" style="background:var(--koku-paper-raised);border:1px solid var(--koku-mist)">
                            <i class="bi bi-calendar3 fs-5 text-koku-accent mb-2 d-block"></i>
                            <div class="fw-semibold small mb-1">Günlük log</div>
                            <div class="small text-koku-muted">Her gün hangi kokuyu kullandığını not al.</div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-4">
                        <div class="p-3 rounded-3 h-100" style="background:var(--koku-paper-raised);border:1px solid var(--koku-mist)">
                            <i class="bi bi-people fs-5 text-koku-accent mb-2 d-block"></i>
                            <div class="fw-semibold small mb-1">Topluluk</div>
                            <div class="small text-koku-muted">Parfüm meraklılarıyla tanış, paylaş, keşfet.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
