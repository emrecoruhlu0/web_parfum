@model WebParfum.ViewModels.MessagesIndexViewModel

@{
    ViewData["Title"] = "Mesajlar";
}

@*
    TODO arkadaş: Mesaj kutusu (conversation listesi).
    - Her satır: karşı kullanıcı, son mesaj snippet'i, okunmamış sayısı, tarih
    - Tıklayınca Conversation/{username}'a git

    Model.Conversations:
      .OtherUser.Username
      .LastMessage.Body, .CreatedAt, .SenderId (kendi mi gönderdi?)
      .UnreadCount
*@

<h2>Mesajlar</h2>

@if (!Model.Conversations.Any())
{
    <p>Henüz konuşma yok.</p>
}
else
{
    <ul>
        @foreach (var c in Model.Conversations)
        {
            <li style="@(c.UnreadCount > 0 ? "font-weight:bold" : "")">
                <a asp-action="Conversation" asp-route-username="@c.OtherUser.Username">
                    @c.OtherUser.Username
                </a>
                @if (c.UnreadCount > 0)
                {
                    <span>(@c.UnreadCount yeni)</span>
                }
                <br />
                <small>@c.LastMessage.Body</small>
                <small>— @c.LastMessage.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
            </li>
        }
    </ul>
}
