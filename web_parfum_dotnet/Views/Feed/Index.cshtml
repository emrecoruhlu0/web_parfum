@model WebParfum.ViewModels.FeedViewModel

@{
    ViewData["Title"] = "Ana Akış";
}

@*
    TODO arkadaş: Ana akış (timeline) sayfası.
    - Takip ettiğin kullanıcıların review ve günlük log aktiviteleri
    - Her item: actor.Username, parfüm, içerik, tarih
    - Boş ise (takip yoksa) en popüler parfümler gösterilir

    Model.HasFollows -> kullanıcı kimseyi takip ediyor mu
    Model.Items -> List<FeedItem> { Type, CreatedAt, Actor, Perfume, ... }
       Type=="review" -> Rating, Body
       Type=="log"    -> LogDate, Sprays, Note
    Model.FallbackPopular -> List<Perfume> (Items boşsa kullan)
*@

<h2>Merhaba, @User.Identity?.Name!</h2>

@if (Model.Items.Any())
{
    <p>Takip ettiklerinden son aktiviteler:</p>
    <ul>
        @foreach (var item in Model.Items)
        {
            <li>
                <strong>@item.Actor.Username</strong>
                @if (item.Type == "review")
                {
                    <text>
                        <a asp-controller="Perfumes" asp-action="Details" asp-route-id="@item.Perfume.Id">
                            @item.Perfume.Name
                        </a>
                        parfümüne @item.Rating/5 verdi.
                        @if (!string.IsNullOrEmpty(item.Body)) { <em>— "@item.Body"</em> }
                    </text>
                }
                else if (item.Type == "log")
                {
                    <text>
                        <a asp-controller="Perfumes" asp-action="Details" asp-route-id="@item.Perfume.Id">
                            @item.Perfume.Name
                        </a>
                        kokusunu kullandı (@item.LogDate?.ToString("dd.MM.yyyy")).
                        @if (item.Sprays > 0) { <text>@item.Sprays sıkım.</text> }
                        @if (!string.IsNullOrEmpty(item.Note)) { <em>— "@item.Note"</em> }
                    </text>
                }
                <small>(@item.CreatedAt.ToString("dd.MM HH:mm"))</small>
            </li>
        }
    </ul>
}
else
{
    @if (!Model.HasFollows)
    {
        <p>Henüz kimseyi takip etmiyorsun. Aşağıda popüler parfümleri görebilirsin.</p>
    }
    else
    {
        <p>Takip ettiğin kişiler henüz aktivite paylaşmamış.</p>
    }

    <h3>Popüler Parfümler</h3>
    <ul>
        @foreach (var p in Model.FallbackPopular)
        {
            <li>
                <a asp-controller="Perfumes" asp-action="Details" asp-route-id="@p.Id">
                    @p.Name — @p.Brand
                </a>
                @if (p.RatingValue.HasValue) { <text>(@p.RatingValue?.ToString("F2"))</text> }
            </li>
        }
    </ul>
}
