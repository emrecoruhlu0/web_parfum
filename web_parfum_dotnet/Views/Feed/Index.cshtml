@model WebParfum.ViewModels.FeedViewModel

@{
    ViewData["Title"] = "Ana Akış";
    ViewData["ActivePage"] = "Feed";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="font-serif fs-3 mb-0">Ana Akış</h1>
    <a asp-controller="Perfumes" asp-action="Index" class="btn btn-amber btn-sm">
        <i class="bi bi-search me-1"></i> Yeni Parfüm Keşfet
    </a>
</div>

@if (Model.Items.Any())
{
    <div class="d-flex flex-column gap-3">
        @foreach (var item in Model.Items)
        {
            <div class="parfum-card p-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="profile-avatar-sm flex-shrink-0">
                        @item.Actor.Username.Substring(0, 1).ToUpper()
                    </div>
                    <div class="flex-grow-1 min-w-0">
                        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                            <a asp-controller="Profile" asp-action="View" asp-route-username="@item.Actor.Username"
                               class="fw-semibold text-decoration-none text-dark">
                                @item.Actor.Username
                            </a>
                            @if (item.Type == "review")
                            {
                                <span class="badge bg-amber-soft text-amber">
                                    <i class="bi bi-star-fill me-1"></i>Yorum
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted">
                                    <i class="bi bi-droplet-fill me-1"></i>Günlük Log
                                </span>
                            }
                            <small class="text-muted ms-auto">@item.CreatedAt.ToString("dd.MM HH:mm")</small>
                        </div>

                        @{ var timelinePh = $"https://placehold.co/56x56/f8e8d0/d97706?text={Uri.EscapeDataString(item.Perfume.Brand?.Length > 0 ? item.Perfume.Brand.Substring(0, Math.Min(2, item.Perfume.Brand.Length)) : "?")}"; }
                        <a asp-controller="Perfumes" asp-action="Details" asp-route-id="@item.Perfume.Id"
                           class="text-decoration-none d-flex align-items-center gap-2 mt-1">
                            <img src="@(string.IsNullOrEmpty(item.Perfume.ImageUrl) ? timelinePh : item.Perfume.ImageUrl)"
                                 alt="@item.Perfume.Name"
                                 style="width:40px;height:40px;border-radius:8px;object-fit:cover;border:1px solid #f0ece6;flex-shrink:0;"
                                 onerror="this.src='@timelinePh'" />
                            <div>
                                <span class="fw-medium text-dark">@item.Perfume.Name</span>
                                <span class="text-muted small ms-1">— @item.Perfume.Brand</span>
                            </div>
                        </a>

                        @if (item.Type == "review")
                        {
                            <div class="mt-1">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= (item.Rating ?? 0) ? "bi-star-fill star" : "bi-star star-empty") small"></i>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(item.Body))
                            {
                                <p class="text-muted small mt-1 mb-0 fst-italic">"@item.Body"</p>
                            }
                        }
                        else
                        {
                            <div class="text-muted small mt-1">
                                @if (item.Sprays > 0)
                                {
                                    <span class="me-2"><i class="bi bi-droplet me-1"></i>@item.Sprays sıkım</span>
                                }
                                @if (item.LogDate.HasValue)
                                {
                                    <span><i class="bi bi-calendar3 me-1"></i>@item.LogDate?.ToString("dd.MM.yyyy")</span>
                                }
                                @if (!string.IsNullOrEmpty(item.Note))
                                {
                                    <p class="fst-italic mt-1 mb-0">"@item.Note"</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    @if (!Model.HasFollows)
    {
        <div class="text-center py-5">
            <div class="mb-3" style="font-size:3rem; color: var(--parfum-amber);">
                <i class="bi bi-people"></i>
            </div>
            <h5 class="fw-semibold">Henüz kimseyi takip etmiyorsun</h5>
            <p class="text-muted mb-4">Parfüm meraklılarını keşfet ve takip et.</p>
            <a asp-controller="Perfumes" asp-action="Index" class="btn btn-amber">
                <i class="bi bi-search me-1"></i> Parfümleri Keşfet
            </a>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="mb-3" style="font-size:3rem; color: var(--parfum-amber);">
                <i class="bi bi-clock-history"></i>
            </div>
            <h5 class="fw-semibold">Henüz aktivite yok</h5>
            <p class="text-muted">Takip ettiğin kişiler yakında bir şeyler paylaşacak.</p>
        </div>
    }

    @if (Model.FallbackPopular.Any())
    {
        <div class="mt-4">
            <h5 class="fw-semibold mb-3">
                <i class="bi bi-fire me-2 text-amber"></i>Popüler Parfümler
            </h5>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                @foreach (var p in Model.FallbackPopular)
                {
                    <div class="col">
                        @{ var feedPh = $"https://placehold.co/80x80/f8e8d0/d97706?text={Uri.EscapeDataString(p.Brand?.Length > 0 ? p.Brand.Substring(0, Math.Min(2, p.Brand.Length)) : "?")}"; }
                        <a asp-controller="Perfumes" asp-action="Details" asp-route-id="@p.Id"
                           class="text-decoration-none">
                            <div class="parfum-card p-3 h-100">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? feedPh : p.ImageUrl)"
                                         alt="@p.Name"
                                         class="flex-shrink-0"
                                         style="width:48px;height:48px;border-radius:10px;object-fit:cover;border:1px solid #f0ece6;"
                                         onerror="this.src='@feedPh'" />
                                    <div>
                                        <div class="fw-medium text-dark">@p.Name</div>
                                        <div class="text-muted small">@p.Brand</div>
                                        @if (p.RatingValue.HasValue)
                                        {
                                            <div class="small text-amber">
                                                <i class="bi bi-star-fill me-1"></i>@p.RatingValue?.ToString("F1")
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    }
}
