@model WebParfum.ViewModels.FeedViewModel

@{
    ViewData["Title"] = "Ana Akış";
    ViewData["ActivePage"] = "Feed";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h1 class="font-serif fs-3 mb-0">Ana Akış</h1>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-amber btn-sm" data-bs-toggle="modal" data-bs-target="#sharePostModal">
            <i class="bi bi-plus-lg me-1"></i> Paylaş
        </button>
        <a asp-controller="Perfumes" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-search me-1"></i> Keşfet
        </a>
    </div>
</div>

@if (Model.Recommendations.Any())
{
    @Html.AntiForgeryToken()
    <div class="parfum-card p-4 mb-4" style="background:linear-gradient(135deg,#fffaf2,#fdf4e3);border:1px solid #f0e2cf">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h5 class="fw-bold mb-1"><i class="bi bi-magic text-amber me-2"></i>Sana Özel Öneriler</h5>
                <small class="text-muted">Koku profiline göre seçildi</small>
            </div>
            <a asp-controller="Profile" asp-action="View"
               asp-route-username="@User.Identity?.Name" asp-route-section="taste"
               class="btn btn-sm btn-outline-secondary">
                Tümünü Gör
            </a>
        </div>
        <div class="d-flex gap-3 overflow-auto pb-2" style="scroll-snap-type:x mandatory">
            @foreach (var r in Model.Recommendations)
            {
                var recPh = $"https://placehold.co/80x80/f8e8d0/d97706?text={Uri.EscapeDataString(r.Perfume.Brand?.Length > 0 ? r.Perfume.Brand.Substring(0, Math.Min(2, r.Perfume.Brand.Length)) : "?")}";
                bool? fbState = Model.FeedbackStates.TryGetValue(r.Perfume.Id, out var fb) ? fb : null;
                <div class="flex-shrink-0" data-rec-card style="width:200px;scroll-snap-align:start">
                    <div class="parfum-card p-3 h-100 d-flex flex-column" style="background:white">
                        <a asp-controller="Perfumes" asp-action="Details" asp-route-id="@r.Perfume.Id"
                           class="text-decoration-none">
                            <img src="@(string.IsNullOrEmpty(r.Perfume.ImageUrl) ? recPh : r.Perfume.ImageUrl)"
                                 alt="@r.Perfume.Name"
                                 style="width:100%;height:120px;border-radius:8px;object-fit:cover;border:1px solid #f0ece6;"
                                 onerror="this.src='@recPh'" />
                            <div class="mt-2">
                                <div class="fw-medium text-dark text-truncate">@r.Perfume.Name</div>
                                <div class="text-muted small text-truncate">@r.Perfume.Brand</div>
                                <div class="mt-1 d-flex align-items-center justify-content-between">
                                    <span class="badge bg-amber-soft text-amber">%@((int)Math.Round(r.Score * 100)) uyum</span>
                                    @if (r.Perfume.RatingValue.HasValue)
                                    {
                                        <span class="small text-amber"><i class="bi bi-star-fill me-1"></i>@r.Perfume.RatingValue?.ToString("F1")</span>
                                    }
                                </div>
                            </div>
                        </a>
                        <div class="mt-2 pt-2 border-top d-flex justify-content-center">
                            @await Html.PartialAsync("_RecommendationFeedback", (r.Perfume.Id, fbState))
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Hızlı paylaşım kartı -->
<div class="parfum-card p-3 mb-4 d-flex align-items-center gap-3">
    <div class="profile-avatar-sm flex-shrink-0">
        @User.Identity?.Name?.Substring(0, 1).ToUpper()
    </div>
    <button type="button" class="btn btn-light w-100 text-start text-muted rounded-pill"
            style="background:#faf3e9; border:1px solid #f0e2cf;"
            data-bs-toggle="modal" data-bs-target="#sharePostModal">
        <i class="bi bi-droplet me-2 text-amber"></i>
        Bugün hangi parfümü denedin? Paylaş…
    </button>
</div>

@if (Model.Items.Any())
{
    <div class="d-flex flex-column gap-3">
        @foreach (var item in Model.Items)
        {
            <div class="parfum-card p-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="profile-avatar-sm flex-shrink-0">
                        @item.Actor.Username.Substring(0, 1).ToUpper()
                    </div>
                    <div class="flex-grow-1 min-w-0">
                        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                            <a asp-controller="Profile" asp-action="View" asp-route-username="@item.Actor.Username"
                               class="fw-semibold text-decoration-none text-dark">
                                @item.Actor.Username
                            </a>
                            @if (item.Type == "review")
                            {
                                <span class="badge bg-amber-soft text-amber">
                                    <i class="bi bi-star-fill me-1"></i>Yorum
                                </span>
                            }
                            else if (item.Type == "community")
                            {
                                <span class="badge bg-info-subtle text-info">
                                    <i class="bi bi-people-fill me-1"></i>Topluluk
                                </span>
                                @if (item.Community != null)
                                {
                                    <a asp-controller="Communities" asp-action="Details" asp-route-id="@item.Community.Id"
                                       class="small text-decoration-none text-muted">
                                        @item.Community.Name
                                    </a>
                                }
                            }
                            else
                            {
                                <span class="badge bg-light text-muted">
                                    <i class="bi bi-droplet-fill me-1"></i>Günlük Log
                                </span>
                            }
                            <small class="text-muted ms-auto">@item.CreatedAt.ToString("dd.MM HH:mm")</small>
                        </div>

                        @if (item.Type == "community" && !string.IsNullOrEmpty(item.Body))
                        {
                            <p class="mb-2 mt-1">@item.Body</p>
                        }

                        @if (item.Perfume != null)
                        {
                            var timelinePh = $"https://placehold.co/56x56/f8e8d0/d97706?text={Uri.EscapeDataString(item.Perfume.Brand?.Length > 0 ? item.Perfume.Brand.Substring(0, Math.Min(2, item.Perfume.Brand.Length)) : "?")}";
                            <a asp-controller="Perfumes" asp-action="Details" asp-route-id="@item.Perfume.Id"
                               class="text-decoration-none d-flex align-items-center gap-2 mt-1">
                                <img src="@(string.IsNullOrEmpty(item.Perfume.ImageUrl) ? timelinePh : item.Perfume.ImageUrl)"
                                     alt="@item.Perfume.Name"
                                     style="width:40px;height:40px;border-radius:8px;object-fit:cover;border:1px solid #f0ece6;flex-shrink:0;"
                                     onerror="this.src='@timelinePh'" />
                                <div>
                                    <span class="fw-medium text-dark">@item.Perfume.Name</span>
                                    <span class="text-muted small ms-1">— @item.Perfume.Brand</span>
                                </div>
                            </a>
                        }

                        @if (item.Type == "review")
                        {
                            <div class="mt-1">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= (item.Rating ?? 0) ? "bi-star-fill star" : "bi-star star-empty") small"></i>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(item.Body))
                            {
                                <p class="text-muted small mt-1 mb-0 fst-italic">"@item.Body"</p>
                            }
                        }
                        else if (item.Type == "log")
                        {
                            <div class="text-muted small mt-1">
                                @if (item.Sprays > 0)
                                {
                                    <span class="me-2"><i class="bi bi-droplet me-1"></i>@item.Sprays sıkım</span>
                                }
                                @if (item.LogDate.HasValue)
                                {
                                    <span><i class="bi bi-calendar3 me-1"></i>@item.LogDate?.ToString("dd.MM.yyyy")</span>
                                }
                                @if (!string.IsNullOrEmpty(item.Note))
                                {
                                    <p class="fst-italic mt-1 mb-0">"@item.Note"</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    @if (!Model.HasFollows)
    {
        <div class="text-center py-5">
            <div class="mb-3" style="font-size:3rem; color: var(--parfum-amber);">
                <i class="bi bi-people"></i>
            </div>
            <h5 class="fw-semibold">Henüz kimseyi takip etmiyorsun</h5>
            <p class="text-muted mb-4">Parfüm meraklılarını keşfet ve takip et.</p>
            <a asp-controller="Perfumes" asp-action="Index" class="btn btn-amber">
                <i class="bi bi-search me-1"></i> Parfümleri Keşfet
            </a>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="mb-3" style="font-size:3rem; color: var(--parfum-amber);">
                <i class="bi bi-clock-history"></i>
            </div>
            <h5 class="fw-semibold">Henüz aktivite yok</h5>
            <p class="text-muted">Takip ettiğin kişiler yakında bir şeyler paylaşacak.</p>
        </div>
    }

    @if (Model.FallbackPopular.Any())
    {
        <div class="mt-4">
            <h5 class="fw-semibold mb-3">
                <i class="bi bi-fire me-2 text-amber"></i>Popüler Parfümler
            </h5>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                @foreach (var p in Model.FallbackPopular)
                {
                    <div class="col">
                        @{ var feedPh = $"https://placehold.co/80x80/f8e8d0/d97706?text={Uri.EscapeDataString(p.Brand?.Length > 0 ? p.Brand.Substring(0, Math.Min(2, p.Brand.Length)) : "?")}"; }
                        <a asp-controller="Perfumes" asp-action="Details" asp-route-id="@p.Id"
                           class="text-decoration-none">
                            <div class="parfum-card p-3 h-100">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? feedPh : p.ImageUrl)"
                                         alt="@p.Name"
                                         class="flex-shrink-0"
                                         style="width:48px;height:48px;border-radius:10px;object-fit:cover;border:1px solid #f0ece6;"
                                         onerror="this.src='@feedPh'" />
                                    <div>
                                        <div class="fw-medium text-dark">@p.Name</div>
                                        <div class="text-muted small">@p.Brand</div>
                                        @if (p.RatingValue.HasValue)
                                        {
                                            <div class="small text-amber">
                                                <i class="bi bi-star-fill me-1"></i>@p.RatingValue?.ToString("F1")
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    }
}

<!-- Paylaş Modal -->
<div class="modal fade" id="sharePostModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title font-serif"><i class="bi bi-droplet text-amber me-2"></i>Paylaş</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-0">
                <!-- Sekme: Yorum / Günlük log -->
                <ul class="nav nav-pills mb-3" role="tablist">
                    <li class="nav-item flex-grow-1">
                        <button type="button" class="nav-link active w-100" data-bs-toggle="tab"
                                data-bs-target="#shareReviewTab">
                            <i class="bi bi-star me-1"></i> Yorum
                        </button>
                    </li>
                    <li class="nav-item flex-grow-1">
                        <button type="button" class="nav-link w-100" data-bs-toggle="tab"
                                data-bs-target="#shareLogTab">
                            <i class="bi bi-calendar3 me-1"></i> Günlük Log
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <!-- Yorum -->
                    <div class="tab-pane fade show active" id="shareReviewTab">
                        <form asp-controller="Reviews" asp-action="Create" method="post">
                            @Html.AntiForgeryToken()

                            <label class="form-label fw-medium small">Parfüm</label>
                            <div class="perfume-autocomplete mb-3">
                                <span class="perfume-chip-holder"></span>
                                <input type="text" class="form-control"
                                       data-perfume-autocomplete data-target="reviewPerfumeId"
                                       placeholder="Parfüm ara…" autocomplete="off" />
                                <input type="hidden" name="perfumeId" id="reviewPerfumeId" required />
                                <div class="perfume-autocomplete-results"></div>
                            </div>

                            <label class="form-label fw-medium small">Puanın</label>
                            <div class="mb-3" id="reviewStars" data-rating-input>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi bi-star fs-4 text-amber me-1" data-value="@i" style="cursor:pointer"></i>
                                }
                                <input type="hidden" name="rating" id="reviewRating" value="0" required />
                            </div>

                            <label class="form-label fw-medium small">Yorumun <span class="text-muted">(opsiyonel)</span></label>
                            <textarea name="body" class="form-control mb-3" rows="3"
                                      placeholder="Bu parfümü nasıl buldun?"></textarea>

                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                                <button type="submit" class="btn btn-amber">
                                    <i class="bi bi-send me-1"></i> Yorumu Paylaş
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Günlük Log -->
                    <div class="tab-pane fade" id="shareLogTab">
                        <form asp-controller="DailyLog" asp-action="Create" method="post">
                            @Html.AntiForgeryToken()

                            <label class="form-label fw-medium small">Parfüm</label>
                            <div class="perfume-autocomplete mb-3">
                                <span class="perfume-chip-holder"></span>
                                <input type="text" class="form-control"
                                       data-perfume-autocomplete data-target="logPerfumeId"
                                       placeholder="Parfüm ara…" autocomplete="off" />
                                <input type="hidden" name="perfumeId" id="logPerfumeId" required />
                                <div class="perfume-autocomplete-results"></div>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-7">
                                    <label class="form-label fw-medium small">Tarih</label>
                                    <input type="date" name="date" class="form-control"
                                           value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                </div>
                                <div class="col-5">
                                    <label class="form-label fw-medium small">Sıkım</label>
                                    <input type="number" name="sprays" class="form-control" value="2" min="0" max="20" />
                                </div>
                            </div>

                            <label class="form-label fw-medium small">Not <span class="text-muted">(opsiyonel)</span></label>
                            <input type="text" name="note" class="form-control mb-3"
                                   placeholder="Bugün nasıl hissettirdi?" />

                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                                <button type="submit" class="btn btn-amber">
                                    <i class="bi bi-send me-1"></i> Logu Paylaş
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Yıldız rating widget
        (function () {
            const wrap = document.getElementById('reviewStars');
            if (!wrap) return;
            const input = document.getElementById('reviewRating');
            const stars = wrap.querySelectorAll('i[data-value]');
            function paint(val) {
                stars.forEach(s => {
                    const v = parseInt(s.dataset.value, 10);
                    s.classList.toggle('bi-star-fill', v <= val);
                    s.classList.toggle('bi-star', v > val);
                });
            }
            stars.forEach(s => {
                s.addEventListener('click', () => {
                    const v = parseInt(s.dataset.value, 10);
                    input.value = v;
                    paint(v);
                });
                s.addEventListener('mouseenter', () => paint(parseInt(s.dataset.value, 10)));
            });
            wrap.addEventListener('mouseleave', () => paint(parseInt(input.value, 10) || 0));
        })();
    </script>

    @if (Model.Recommendations.Any())
    {
        <partial name="_RecommendationFeedbackScripts" />
    }
}
