@model List<WebParfum.Models.Perfume>

@{
    ViewData["Title"] = "Beğendiklerim";
    ViewData["ActivePage"] = "Likes";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="font-serif fs-3 mb-0">Beğendiklerim</h1>
    @if (Model.Any())
    {
        <span class="badge bg-amber-soft text-amber">@Model.Count parfüm</span>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-heart text-muted" style="font-size:3rem"></i>
        <h5 class="fw-semibold mt-3">Henüz parfüm beğenmedin</h5>
        <p class="text-muted mb-4">Keşfet sayfasındaki parfümleri beğenerek burada listele.</p>
        <a asp-controller="Perfumes" asp-action="Index" class="btn btn-amber">
            <i class="bi bi-search me-1"></i> Parfümleri Keşfet
        </a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var p in Model)
        {
            <div class="col">
                <a asp-controller="Perfumes" asp-action="Details" asp-route-id="@p.Id"
                   class="text-decoration-none">
                    <div class="parfum-card p-3 h-100 d-flex align-items-center gap-3">
                        <div class="perfume-thumb flex-shrink-0 d-flex align-items-center justify-content-center"
                             style="width:56px;height:56px;border-radius:10px;background:linear-gradient(135deg,#f8e8d0,#f0d0a8);">
                            <i class="bi bi-droplet-fill text-amber fs-5"></i>
                        </div>
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-medium text-dark text-truncate">@p.Name</div>
                            <div class="text-muted small">@p.Brand</div>
                            @if (p.RatingValue.HasValue)
                            {
                                <div class="small text-amber mt-1">
                                    <i class="bi bi-star-fill me-1" style="font-size:.7rem"></i>@p.RatingValue?.ToString("F1")
                                </div>
                            }
                        </div>
                        <i class="bi bi-heart-fill text-danger flex-shrink-0"></i>
                    </div>
                </a>
            </div>
        }
    </div>
}
