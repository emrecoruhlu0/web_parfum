@model List<WebParfum.Models.Perfume>

@{
    ViewData["Title"] = "Beğendiklerim";
    ViewData["ActivePage"] = "Likes";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="font-display fs-3 mb-0">Beğendiklerim</h1>
    @if (Model.Any())
    {
        <span class="badge bg-amber-soft text-amber">@Model.Count parfüm</span>
    }
</div>

@if (!Model.Any())
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel {
        Icon = "bi-heart",
        Title = "Henüz parfüm beğenmedin",
        Description = "Keşfet sayfasındaki parfümleri beğenerek burada listele.",
        ActionText = "Parfümleri keşfet",
        ActionController = "Perfumes",
        ActionName = "Index"
    })
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var p in Model)
        {
            <div class="col">
                @{ var likesPh = $"https://placehold.co/80x80/f8e8d0/d97706?text={Uri.EscapeDataString(p.Brand?.Length > 0 ? p.Brand.Substring(0, Math.Min(2, p.Brand.Length)) : "?")}"; }
                <a asp-controller="Perfumes" asp-action="Details" asp-route-id="@p.Id"
                   class="text-decoration-none">
                    <div class="parfum-card p-3 h-100 d-flex align-items-center gap-3">
                        <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? likesPh : p.ImageUrl)"
                             alt="@p.Name"
                             class="flex-shrink-0"
                             style="width:56px;height:56px;border-radius:10px;object-fit:cover;border:1px solid #f0ece6;"
                             onerror="this.src='@likesPh'" />
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-medium text-dark text-truncate">@p.Name</div>
                            <div class="text-muted small">@p.Brand</div>
                            @if (p.RatingValue.HasValue)
                            {
                                <div class="small text-amber mt-1">
                                    <i class="bi bi-star-fill me-1" style="font-size:.7rem"></i>@p.RatingValue?.ToString("F1")
                                </div>
                            }
                        </div>
                        <i class="bi bi-heart-fill text-danger flex-shrink-0"></i>
                    </div>
                </a>
            </div>
        }
    </div>
}
