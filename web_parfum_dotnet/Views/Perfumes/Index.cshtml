@model WebParfum.ViewModels.PerfumeIndexViewModel

@{
    ViewData["Title"] = "Keşfet";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="font-serif mb-1">Keşfet</h2>
        <p class="text-muted mb-0">@Model.TotalCount.ToString("N0") parfüm</p>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-dark">
            <i class="bi bi-plus-lg me-1"></i> Yeni Parfüm
        </a>
    }
</div>

<form method="get" class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <input type="text" name="Search" value="@Model.Search" class="form-control"
                       placeholder="İsim veya marka ara..." />
            </div>
            <div class="col-md-2">
                <select name="Brand" class="form-select">
                    <option value="">Tüm markalar</option>
                    @foreach (var b in Model.Brands)
                    {
                        <option value="@b.Value" selected="@(Model.Brand == b.Value)">
                            @b.Value (@b.Count)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="Gender" class="form-select">
                    <option value="">Tüm cinsiyetler</option>
                    @foreach (var g in Model.Genders)
                    {
                        <option value="@g.Value" selected="@(Model.Gender == g.Value)">@g.Value</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="Accord" class="form-select">
                    <option value="">Tüm akorlar</option>
                    @foreach (var a in Model.Accords)
                    {
                        <option value="@a.Value" selected="@(Model.Accord == a.Value)">
                            @a.Value (@a.Count)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="Sort" class="form-select">
                    <option value="popular" selected="@(Model.Sort == "popular")">Popüler</option>
                    <option value="rating" selected="@(Model.Sort == "rating")">Puan</option>
                    <option value="newest" selected="@(Model.Sort == "newest")">Yeni</option>
                </select>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-dark btn-sm">
                <i class="bi bi-funnel me-1"></i> Filtrele
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Temizle</a>
        </div>
    </div>
</form>

<div class="row g-3">
    @foreach (var p in Model.Perfumes)
    {
        var placeholder = $"https://placehold.co/200x200/f8e8d0/d97706?text={Uri.EscapeDataString(p.Brand?.Length > 0 ? p.Brand.Substring(0, Math.Min(2, p.Brand.Length)) : "?")}";
        <div class="col-sm-6 col-lg-4 col-xl-3">
            <a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none">
                <div class="parfum-card card h-100">
                    <div class="perfume-card-img-wrap">
                        <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? placeholder : p.ImageUrl)"
                             alt="@p.Name"
                             class="perfume-card-img"
                             onerror="this.src='@placeholder'" />
                    </div>
                    <div class="card-body pt-2">
                        <h6 class="font-serif mb-0 text-truncate text-dark">@p.Name</h6>
                        <p class="text-muted small mb-2 text-truncate">@p.Brand</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                @if (!string.IsNullOrEmpty(p.Accord1))
                                {
                                    <span class="badge bg-light text-dark border me-1" style="font-size:.65rem">@p.Accord1</span>
                                }
                                @if (!string.IsNullOrEmpty(p.Accord2))
                                {
                                    <span class="badge bg-light text-dark border" style="font-size:.65rem">@p.Accord2</span>
                                }
                            </div>
                            <span class="badge bg-warning text-dark">
                                <i class="bi bi-star-fill"></i> @(p.RatingValue?.ToString("F1") ?? "-")
                            </span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @{
                var prev = Math.Max(1, Model.Page - 1);
                var next = Math.Min(Model.TotalPages, Model.Page + 1);
                var startPage = Math.Max(1, Model.Page - 3);
                var endPage = Math.Min(Model.TotalPages, Model.Page + 3);
            }
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-all-route-data="@PageRoute(prev)">«</a>
            </li>
            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(Model.Page == i ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-all-route-data="@PageRoute(i)">@i</a>
                </li>
            }
            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-all-route-data="@PageRoute(next)">»</a>
            </li>
        </ul>
    </nav>
}

@functions {
    Dictionary<string, string?> PageRoute(int page)
    {
        return new Dictionary<string, string?>
        {
            ["Page"] = page.ToString(),
            ["Search"] = Model.Search,
            ["Brand"] = Model.Brand,
            ["Gender"] = Model.Gender,
            ["Accord"] = Model.Accord,
            ["Sort"] = Model.Sort,
        };
    }
}
