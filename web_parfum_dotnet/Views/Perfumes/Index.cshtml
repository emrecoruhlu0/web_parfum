@model WebParfum.ViewModels.PerfumeIndexViewModel

@{
    ViewData["Title"] = "Keşfet";
    bool HasActive() =>
        !string.IsNullOrEmpty(Model.Brand) ||
        !string.IsNullOrEmpty(Model.Gender) ||
        !string.IsNullOrEmpty(Model.Accord) ||
        !string.IsNullOrEmpty(Model.Search);
}

<div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
    <div>
        <h2 class="font-serif mb-1">Keşfet</h2>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-dark btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Yeni Parfüm Ekle
        </a>
    }
</div>

<form method="get" id="filterForm" class="filter-card">
    <!-- Üst satır: büyük arama + sıralama -->
    <div class="d-flex gap-3 align-items-center flex-wrap mb-3">
        <div class="filter-search-wrap flex-grow-1" style="min-width:260px;">
            <i class="bi bi-search"></i>
            <input type="text" name="Search" value="@Model.Search"
                   class="filter-search-input"
                   placeholder="Parfüm veya marka ara… (Dior, oud, Sauvage)"
                   autocomplete="off" />
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small">Sırala:</span>
            <select name="Sort" id="sortSelect" class="filter-sort-select">
                <option value="popular" selected="@(Model.Sort == "popular")">Popüler</option>
                <option value="rating" selected="@(Model.Sort == "rating")">Puan</option>
                <option value="newest" selected="@(Model.Sort == "newest")">Yeni</option>
            </select>
        </div>
    </div>

    <!-- Hidden: chip filtreler buraya yazıyor -->
    <input type="hidden" name="Brand" id="filterBrand" value="@Model.Brand" />
    <input type="hidden" name="Gender" id="filterGender" value="@Model.Gender" />
    <input type="hidden" name="Accord" id="filterAccord" value="@Model.Accord" />

    @if (Model.Genders.Any())
    {
        <div class="mb-3">
            <div class="filter-section-label">Cinsiyet</div>
            <div class="filter-chips">
                @foreach (var g in Model.Genders)
                {
                    var (gIcon, gColor) = g.Value.ToLower() switch
                    {
                        "men"    => ("bi-gender-male", "#3b82f6"),
                        "women"  => ("bi-gender-female", "#ec4899"),
                        "unisex" => ("bi-gender-ambiguous", "#a855f7"),
                        _        => ("bi-person", "#888")
                    };
                    var gActive = Model.Gender == g.Value;
                    <a href="javascript:void(0)"
                       class="filter-chip filter-chip-color @(gActive ? "active" : "")"
                       data-filter="Gender" data-value="@g.Value"
                       style="@(gActive ? $"background:{gColor};border-color:{gColor};color:#fff" : $"color:{gColor};border-color:{gColor}33")">
                        <i class="bi @gIcon"></i>
                        @g.Value <span class="chip-count">@g.Count</span>
                    </a>
                }
            </div>
        </div>
    }

    @{
        const int accordVisible = 12;
        const int brandVisible = 15;
    }

    @if (Model.Accords.Any())
    {
        var activeAccordSet = (Model.Accord ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(a => a.Trim()).ToHashSet();
        var accordExpanded = activeAccordSet.Any(a =>
            Model.Accords.FindIndex(f => f.Value == a) >= accordVisible);
        <div class="mb-3">
            <div class="filter-section-label">Akor</div>
            <div class="filter-chips filter-collapsible @(accordExpanded ? "expanded" : "")"
                 data-visible="@accordVisible">
                @for (int i = 0; i < Model.Accords.Count; i++)
                {
                    var a = Model.Accords[i];
                    var st = AccordVisual.Get(a.Value);
                    var active = activeAccordSet.Contains(a.Value);
                    <a href="javascript:void(0)"
                       class="filter-chip filter-chip-color @(active ? "active" : "") @(i >= accordVisible ? "filter-chip-overflow" : "")"
                       data-filter="Accord" data-value="@a.Value"
                       style="@(active ? $"background:{st.Hex};border-color:{st.Hex};color:{st.TextHex}" : $"color:{st.Hex};border-color:{st.Hex}55;background:{st.Hex}10")">
                        <i class="bi @st.Icon"></i>
                        @a.Value <span class="chip-count">@a.Count</span>
                    </a>
                }
                @if (Model.Accords.Count > accordVisible)
                {
                    <button type="button" class="filter-chip filter-toggle-btn">
                        <span class="show-more"><i class="bi bi-chevron-down"></i> @(Model.Accords.Count - accordVisible) tane daha</span>
                        <span class="show-less"><i class="bi bi-chevron-up"></i> Daha az</span>
                    </button>
                }
            </div>
        </div>
    }

    @if (Model.Brands.Any())
    {
        <div>
            <div class="filter-section-label">
                Marka
                <span class="text-muted fw-normal" style="text-transform:none;letter-spacing:0">
                    (@Model.Brands.Count toplam)
                </span>
            </div>
            <div class="brand-dropdown" id="brandDropdown">
                <button type="button" class="brand-dropdown-trigger" id="brandDropdownToggle">
                    <i class="bi bi-tag me-2"></i>
                    <span id="brandLabelText" class="@(string.IsNullOrEmpty(Model.Brand) ? "text-muted" : "fw-medium text-amber")">
                        @(string.IsNullOrEmpty(Model.Brand) ? "Marka seç…" : Model.Brand)
                    </span>
                    <span id="brandClearWrap" class="@(string.IsNullOrEmpty(Model.Brand) ? "d-none" : "")">
                        <a href="javascript:void(0)" class="brand-clear ms-2"
                           data-clear-brand title="Markayı temizle">
                            <i class="bi bi-x-circle-fill"></i>
                        </a>
                    </span>
                    <i class="bi bi-chevron-down ms-auto"></i>
                </button>
                <div class="brand-dropdown-panel">
                    <div class="brand-dropdown-search">
                        <i class="bi bi-search"></i>
                        <input type="text" id="brandSearchInput"
                               class="form-control form-control-sm"
                               placeholder="Marka ara…" autocomplete="off" />
                    </div>
                    <div class="brand-dropdown-list" id="brandDropdownList">
                        @foreach (var b in Model.Brands)
                        {
                            var active = Model.Brand == b.Value;
                            <a href="javascript:void(0)"
                               class="brand-dropdown-item @(active ? "active" : "")"
                               data-filter="Brand" data-value="@b.Value">
                                <span class="brand-name">@b.Value</span>
                                <span class="brand-count">@b.Count</span>
                                @if (active)
                                {
                                    <i class="bi bi-check2 brand-check"></i>
                                }
                            </a>
                        }
                        <div class="brand-dropdown-empty" id="brandDropdownEmpty">
                            Sonuç yok
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div id="activeBar"></div>
</form>

<div id="perfumeResults">
    @await Html.PartialAsync("_PerfumeGrid", Model)
</div>

@functions {
    Dictionary<string, string?> RouteWithout(string remove)
    {
        var r = new Dictionary<string, string?>
        {
            ["Search"] = Model.Search,
            ["Brand"] = Model.Brand,
            ["Gender"] = Model.Gender,
            ["Accord"] = Model.Accord,
            ["Sort"] = Model.Sort,
        };
        r[remove] = null;
        return r;
    }
}

@section Scripts {
    <script>
        (function () {
            const filterForm = document.getElementById('filterForm');
            const resultsContainer = document.getElementById('perfumeResults');
            if (!filterForm || !resultsContainer) return;

            // AJAX ile filtre uygula → focus input'ta kalır, sadece grid yenilenir.
            let currentController = null;
            let isFetching = false;

            async function applyFilters({ resetPage = true } = {}) {
                if (resetPage) {
                    // Yeni filtreleme her zaman 1. sayfadan başlar
                    const url = new URL(window.location.href);
                    url.searchParams.delete('Page');
                    history.replaceState(null, '', url.pathname + url.search);
                }

                if (currentController) currentController.abort();
                currentController = new AbortController();

                const params = new URLSearchParams(new FormData(filterForm));
                const url = `${window.location.pathname}?${params.toString()}`;

                isFetching = true;
                resultsContainer.classList.add('is-loading');
                try {
                    const res = await fetch(url, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'text/html' },
                        signal: currentController.signal
                    });
                    if (!res.ok) return;
                    const html = await res.text();
                    resultsContainer.innerHTML = html;
                    history.replaceState(null, '', url);
                } catch (e) {
                    if (e.name !== 'AbortError') console.error(e);
                } finally {
                    isFetching = false;
                    resultsContainer.classList.remove('is-loading');
                }
            }

            // ── Brand buton güncelle ──────────────────────────────────────
            function updateBrandButton(value) {
                const label     = document.getElementById('brandLabelText');
                const clearWrap = document.getElementById('brandClearWrap');
                if (!label) return;
                if (value) {
                    label.textContent = value;
                    label.className   = 'fw-medium text-amber';
                    clearWrap?.classList.remove('d-none');
                } else {
                    label.textContent = 'Marka seç…';
                    label.className   = 'text-muted';
                    clearWrap?.classList.add('d-none');
                }
            }

            // ── Aktif filtre barı ─────────────────────────────────────────
            const activeBar = document.getElementById('activeBar');

            // Seçili akorları JS'de Set olarak tut
            const selectedAccords = new Set(
                '@Html.Raw(Model.Accord ?? "")'
                    .split(',').map(s => s.trim()).filter(Boolean)
            );

            function syncAccordInput() {
                document.getElementById('filterAccord').value = [...selectedAccords].join(',');
            }

            function renderActivePills() {
                if (!activeBar) return;
                const search  = filterForm.querySelector('input[name="Search"]')?.value?.trim() || '';
                const brand   = document.getElementById('filterBrand')?.value?.trim()  || '';
                const gender  = document.getElementById('filterGender')?.value?.trim() || '';

                if (!search && !brand && !gender && selectedAccords.size === 0) {
                    activeBar.innerHTML = '';
                    return;
                }

                let html = '<span class="text-muted small fw-medium me-1"><i class="bi bi-funnel-fill text-amber me-1"></i>Aktif:</span>';
                if (search) html += `<span class="filter-active-pill">"${search}" <a href="#" data-pill-clear="Search"><i class="bi bi-x"></i></a></span>`;
                if (brand)  html += `<span class="filter-active-pill">Marka: ${brand} <a href="#" data-pill-clear="Brand"><i class="bi bi-x"></i></a></span>`;
                if (gender) html += `<span class="filter-active-pill">${gender} <a href="#" data-pill-clear="Gender"><i class="bi bi-x"></i></a></span>`;
                selectedAccords.forEach(a => {
                    html += `<span class="filter-active-pill">Akor: ${a} <a href="#" data-pill-clear="Accord" data-accord-val="${a}"><i class="bi bi-x"></i></a></span>`;
                });
                html += '<a href="/Perfumes" class="text-muted small text-decoration-none ms-auto"><i class="bi bi-arrow-counterclockwise"></i> Tümünü temizle</a>';
                activeBar.innerHTML = html;
            }

            // Pill X tıklaması — event delegation
            activeBar?.addEventListener('click', (e) => {
                const a = e.target.closest('[data-pill-clear]');
                if (!a) return;
                e.preventDefault();
                const key = a.dataset.pillClear;
                if (key === 'Search') {
                    filterForm.querySelector('input[name="Search"]').value = '';
                } else if (key === 'Accord') {
                    const val = a.dataset.accordVal;
                    if (val) {
                        selectedAccords.delete(val);
                        document.querySelectorAll(`[data-filter="Accord"][data-value="${val}"]`)
                            .forEach(c => {
                                c.classList.remove('active');
                                const bg = c.dataset.colorBg;
                                if (bg) { c.style.background = bg+'10'; c.style.borderColor = bg+'55'; c.style.color = bg; }
                            });
                    } else {
                        selectedAccords.clear();
                        document.querySelectorAll('[data-filter="Accord"]').forEach(c => c.classList.remove('active'));
                    }
                    syncAccordInput();
                } else {
                    const inp = document.getElementById('filter' + key);
                    if (inp) inp.value = '';
                    document.querySelectorAll(`[data-filter="${key}"]`).forEach(c => c.classList.remove('active'));
                    if (key === 'Brand') updateBrandButton('');
                }
                renderActivePills();
                applyFilters();
            });

            // Sayfa ilk yüklendiğinde mevcut durumu göster
            renderActivePills();

            // Search input — debounce 300ms
            const searchInput = filterForm.querySelector('input[name="Search"]');
            if (searchInput) {
                let searchTimer;
                searchInput.addEventListener('input', () => {
                    clearTimeout(searchTimer);
                    renderActivePills();
                    searchTimer = setTimeout(applyFilters, 300);
                });
            }
            filterForm.addEventListener('submit', (e) => {
                e.preventDefault();
                applyFilters();
            });

            // Sort select
            const sortSelect = document.getElementById('sortSelect');
            if (sortSelect) sortSelect.addEventListener('change', () => applyFilters());

            // Chip tıklaması
            document.querySelectorAll('[data-filter][data-value]').forEach(chip => {
                chip.addEventListener('click', (e) => {
                    e.preventDefault();
                    const key = chip.dataset.filter;
                    const val = chip.dataset.value;

                    if (key === 'Accord') {
                        const bg = chip.dataset.colorBg;
                        const tx = chip.dataset.colorText;
                        if (selectedAccords.has(val)) {
                            selectedAccords.delete(val);
                            chip.classList.remove('active');
                            if (bg) { chip.style.background = bg+'10'; chip.style.borderColor = bg+'55'; chip.style.color = bg; }
                        } else {
                            selectedAccords.add(val);
                            chip.classList.add('active');
                            if (bg) { chip.style.background = bg; chip.style.borderColor = bg; chip.style.color = tx||'#fff'; }
                        }
                        syncAccordInput();
                    } else {
                        const input = document.getElementById('filter' + key);
                        if (!input) return;
                        input.value = (input.value === val) ? '' : val;
                        if (key === 'Brand') updateBrandButton(input.value);
                    }
                    renderActivePills();
                    applyFilters();
                });
            });

            // "Daha fazla göster / daha az" toggle (akor satırı için)
            document.querySelectorAll('.filter-toggle-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const wrap = btn.closest('.filter-collapsible');
                    if (wrap) wrap.classList.toggle('expanded');
                });
            });

            // Marka dropdown: aç/kapa, arama, dış tıkla kapat, X ile temizle
            (function () {
                const wrap = document.getElementById('brandDropdown');
                if (!wrap) return;
                const toggle = document.getElementById('brandDropdownToggle');
                const search = document.getElementById('brandSearchInput');
                const list = document.getElementById('brandDropdownList');
                const empty = document.getElementById('brandDropdownEmpty');

                toggle.addEventListener('click', (e) => {
                    if (e.target.closest('[data-clear-brand]')) return;
                    wrap.classList.toggle('open');
                    if (wrap.classList.contains('open')) {
                        setTimeout(() => search.focus(), 50);
                    }
                });

                document.addEventListener('click', (e) => {
                    if (!wrap.contains(e.target)) wrap.classList.remove('open');
                });

                search.addEventListener('input', () => {
                    const q = search.value.trim().toLowerCase();
                    let visible = 0;
                    list.querySelectorAll('.brand-dropdown-item').forEach(item => {
                        const name = (item.querySelector('.brand-name')?.textContent || '').toLowerCase();
                        const match = !q || name.includes(q);
                        item.style.display = match ? '' : 'none';
                        if (match) visible++;
                    });
                    empty.style.display = visible === 0 ? 'block' : 'none';
                });

                search.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape') wrap.classList.remove('open');
                });

                wrap.addEventListener('click', (e) => {
                    if (!e.target.closest('[data-clear-brand]')) return;
                    e.stopPropagation();
                    document.getElementById('filterBrand').value = '';
                    updateBrandButton('');
                    renderActivePills();
                    applyFilters();
                });
            })();
        })();
    </script>
}
