@model WebParfum.ViewModels.PerfumeIndexViewModel

@{
    ViewData["Title"] = "Keşfet";
}

<div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
    <div>
        <h2 class="font-serif mb-1">Keşfet</h2>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-dark btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Yeni Parfüm Ekle
        </a>
    }
</div>

<form method="get" id="filterForm" class="filter-card">
    <!-- Üst satır: büyük arama + sıralama -->
    <div class="d-flex gap-3 align-items-center flex-wrap mb-3">
        <div class="filter-search-wrap flex-grow-1" style="min-width:260px;">
            <i class="bi bi-search"></i>
            <input type="text" name="Search" value="@Model.Search"
                   class="filter-search-input"
                   placeholder="Parfüm veya marka ara… (Dior, oud, Sauvage)"
                   autocomplete="off" />
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small">Sırala:</span>
            <select name="Sort" id="sortSelect" class="filter-sort-select">
                <option value="popular" selected="@(Model.Sort == "popular")">Popüler</option>
                <option value="rating" selected="@(Model.Sort == "rating")">Puan</option>
                <option value="newest" selected="@(Model.Sort == "newest")">Yeni</option>
            </select>
        </div>
    </div>

    @if (Model.Genders.Any())
    {
        <div class="mb-3">
            <div class="filter-section-label">Cinsiyet</div>
            <div class="filter-chips">
                @foreach (var g in Model.Genders)
                {
                    var (gIcon, gColor) = g.Value.ToLower() switch
                    {
                        "men"    => ("bi-gender-male", "#3b82f6"),
                        "women"  => ("bi-gender-female", "#ec4899"),
                        "unisex" => ("bi-gender-ambiguous", "#a855f7"),
                        _        => ("bi-person", "#888")
                    };
                    var gActive = Model.Gender.Contains(g.Value);
                    <a href="javascript:void(0)"
                       class="filter-chip filter-chip-color @(gActive ? "active" : "")"
                       data-filter="Gender" data-value="@g.Value"
                       style="@(gActive ? $"background:{gColor};border-color:{gColor};color:#fff" : $"color:{gColor};border-color:{gColor}33")">
                        <i class="bi @gIcon"></i>
                        @g.Value <span class="chip-count">@g.Count</span>
                    </a>
                }
            </div>
        </div>
    }

    @{
        const int accordVisible = 12;
    }

    @if (Model.Accords.Any())
    {
        var accordActiveIdx = Model.Accord.Count > 0
            ? Model.Accords.FindIndex(a => Model.Accord.Contains(a.Value))
            : -1;
        var accordExpanded = accordActiveIdx >= accordVisible;
        <div class="mb-3">
            <div class="filter-section-label">Akor</div>
            <div class="filter-chips filter-collapsible @(accordExpanded ? "expanded" : "")"
                 data-visible="@accordVisible">
                @for (int i = 0; i < Model.Accords.Count; i++)
                {
                    var a = Model.Accords[i];
                    var st = AccordVisual.Get(a.Value);
                    var active = Model.Accord.Contains(a.Value);
                    <a href="javascript:void(0)"
                       class="filter-chip filter-chip-color @(active ? "active" : "") @(i >= accordVisible ? "filter-chip-overflow" : "")"
                       data-filter="Accord" data-value="@a.Value"
                       style="@(active ? $"background:{st.Hex};border-color:{st.Hex};color:{st.TextHex}" : $"color:{st.Hex};border-color:{st.Hex}55;background:{st.Hex}10")">
                        <i class="bi @st.Icon"></i>
                        @a.Value <span class="chip-count">@a.Count</span>
                    </a>
                }
                @if (Model.Accords.Count > accordVisible)
                {
                    <button type="button" class="filter-chip filter-toggle-btn">
                        <span class="show-more"><i class="bi bi-chevron-down"></i> @(Model.Accords.Count - accordVisible) tane daha</span>
                        <span class="show-less"><i class="bi bi-chevron-up"></i> Daha az</span>
                    </button>
                }
            </div>
        </div>
    }

    @if (Model.Brands.Any())
    {
        <div>
            <div class="filter-section-label">
                Marka
                <span class="text-muted fw-normal" style="text-transform:none;letter-spacing:0">
                    (@Model.Brands.Count toplam@(Model.Brand.Count > 0 ? $" · {Model.Brand.Count} seçili" : ""))
                </span>
            </div>
            <div class="brand-dropdown" id="brandDropdown">
                <button type="button" class="brand-dropdown-trigger" id="brandDropdownToggle">
                    <i class="bi bi-tag me-2"></i>
                    @if (Model.Brand.Count == 0)
                    {
                        <span class="text-muted">Marka seç…</span>
                    }
                    else if (Model.Brand.Count == 1)
                    {
                        <span class="fw-medium text-amber">@Model.Brand[0]</span>
                        <a href="javascript:void(0)" class="brand-clear ms-2"
                           data-clear-brand title="Markaları temizle">
                            <i class="bi bi-x-circle-fill"></i>
                        </a>
                    }
                    else
                    {
                        <span class="fw-medium text-amber">@Model.Brand.Count marka seçili</span>
                        <a href="javascript:void(0)" class="brand-clear ms-2"
                           data-clear-brand title="Markaları temizle">
                            <i class="bi bi-x-circle-fill"></i>
                        </a>
                    }
                    <i class="bi bi-chevron-down ms-auto"></i>
                </button>
                <div class="brand-dropdown-panel">
                    <div class="brand-dropdown-search">
                        <i class="bi bi-search"></i>
                        <input type="text" id="brandSearchInput"
                               class="form-control form-control-sm"
                               placeholder="Marka ara…" autocomplete="off" />
                    </div>
                    <div class="brand-dropdown-list" id="brandDropdownList">
                        @foreach (var b in Model.Brands)
                        {
                            var active = Model.Brand.Contains(b.Value);
                            <a href="javascript:void(0)"
                               class="brand-dropdown-item @(active ? "active" : "")"
                               data-filter="Brand" data-value="@b.Value">
                                <span class="brand-name">@b.Value</span>
                                <span class="brand-count">@b.Count</span>
                                <i class="bi bi-check2 brand-check" style="@(active ? "" : "visibility:hidden")"></i>
                            </a>
                        }
                        <div class="brand-dropdown-empty" id="brandDropdownEmpty">
                            Sonuç yok
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Model.HasAnyFilter)
    {
        <div class="filter-active-bar">
            <span class="text-muted small fw-medium me-1">
                <i class="bi bi-funnel-fill text-amber me-1"></i>Aktif:
            </span>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <span class="filter-active-pill" data-remove-filter data-key="Search" data-value="">
                    "@Model.Search"
                    <a href="javascript:void(0)"><i class="bi bi-x"></i></a>
                </span>
            }
            @foreach (var b in Model.Brand)
            {
                <span class="filter-active-pill" data-remove-filter data-key="Brand" data-value="@b">
                    Marka: @b
                    <a href="javascript:void(0)"><i class="bi bi-x"></i></a>
                </span>
            }
            @foreach (var g in Model.Gender)
            {
                <span class="filter-active-pill" data-remove-filter data-key="Gender" data-value="@g">
                    @g
                    <a href="javascript:void(0)"><i class="bi bi-x"></i></a>
                </span>
            }
            @foreach (var a in Model.Accord)
            {
                <span class="filter-active-pill" data-remove-filter data-key="Accord" data-value="@a">
                    Akor: @a
                    <a href="javascript:void(0)"><i class="bi bi-x"></i></a>
                </span>
            }
            <a href="javascript:void(0)" id="clearAllFilters"
               class="text-muted small text-decoration-none ms-auto">
                <i class="bi bi-arrow-counterclockwise"></i> Tümünü temizle
            </a>
        </div>
    }
</form>

<div id="perfumeResults">
    @await Html.PartialAsync("_PerfumeGrid", Model)
</div>

@section Scripts {
    <script>
        (function () {
            const filterForm = document.getElementById('filterForm');
            const resultsContainer = document.getElementById('perfumeResults');
            if (!filterForm || !resultsContainer) return;

            // Aktif çoklu filtreler — sayfa yüklenirken URL'den oku
            const MULTI_KEYS = ['Brand', 'Gender', 'Accord'];
            const activeFilters = { Brand: new Set(), Gender: new Set(), Accord: new Set() };
            (function initFromUrl() {
                const sp = new URLSearchParams(window.location.search);
                MULTI_KEYS.forEach(k => sp.getAll(k).forEach(v => { if (v) activeFilters[k].add(v); }));
            })();

            function buildParams() {
                const params = new URLSearchParams();
                const search = filterForm.querySelector('input[name="Search"]')?.value?.trim();
                if (search) params.set('Search', search);
                const sort = filterForm.querySelector('select[name="Sort"]')?.value;
                if (sort) params.set('Sort', sort);
                MULTI_KEYS.forEach(k => {
                    activeFilters[k].forEach(v => params.append(k, v));
                });
                return params;
            }

            let currentController = null;
            async function applyFilters() {
                if (currentController) currentController.abort();
                currentController = new AbortController();

                const params = buildParams();
                const url = `${window.location.pathname}?${params.toString()}`;

                resultsContainer.classList.add('is-loading');
                try {
                    const res = await fetch(url, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'text/html' },
                        signal: currentController.signal
                    });
                    if (!res.ok) return;
                    const html = await res.text();
                    resultsContainer.innerHTML = html;
                    history.replaceState(null, '', url);
                    syncChipsUI();
                    syncActiveBar();
                } catch (e) {
                    if (e.name !== 'AbortError') console.error(e);
                } finally {
                    resultsContainer.classList.remove('is-loading');
                }
            }

            // UI'yi activeFilters'a göre güncelle (chip active class + dropdown check'i)
            function syncChipsUI() {
                document.querySelectorAll('[data-filter][data-value]').forEach(el => {
                    const k = el.dataset.filter;
                    const v = el.dataset.value;
                    if (!activeFilters[k]) return;
                    const on = activeFilters[k].has(v);
                    el.classList.toggle('active', on);
                    const check = el.querySelector('.brand-check');
                    if (check) check.style.visibility = on ? '' : 'hidden';
                });
                updateBrandTriggerLabel();
            }

            function updateBrandTriggerLabel() {
                const trig = document.getElementById('brandDropdownToggle');
                if (!trig) return;
                const label = trig.querySelector('span');
                if (!label) return;
                const count = activeFilters.Brand.size;
                const clearBtn = trig.querySelector('[data-clear-brand]');
                if (count === 0) {
                    label.className = 'text-muted';
                    label.textContent = 'Marka seç…';
                    if (clearBtn) clearBtn.remove();
                } else {
                    label.className = 'fw-medium text-amber';
                    label.textContent = count === 1
                        ? [...activeFilters.Brand][0]
                        : `${count} marka seçili`;
                    if (!clearBtn) {
                        const a = document.createElement('a');
                        a.href = 'javascript:void(0)';
                        a.className = 'brand-clear ms-2';
                        a.setAttribute('data-clear-brand', '');
                        a.title = 'Markaları temizle';
                        a.innerHTML = '<i class="bi bi-x-circle-fill"></i>';
                        a.addEventListener('click', clearBrand);
                        label.after(a);
                    }
                }
            }

            // Aktif filtre çubuğunu yeniden render et (server-render mantığıyla uyumlu)
            function syncActiveBar() {
                // Sunucu tarafı zaten yeni HTML üretmiyor (sadece grid AJAX'la geliyor).
                // Filtre formundaki active-bar için basit: sayfa yenilenmeden var olan pill'leri
                // gizle/ekle. Pratik çözüm: tıklanan pill'i kaldır, başkasını ekleme — yeni filtre
                // chip'lerden zaten aktif görünüyor. Tam senkron için sayfayı yeniden çizmiyoruz;
                // kullanıcı yeni bir filtre ekleyince mevcut bar yetersizse refresh edilmesi gerekir.
                // Bu yüzden tam-render gerekirse tüm sayfayı yeniden çizelim:
                renderActiveBar();
            }

            function renderActiveBar() {
                // Form içindeki .filter-active-bar'ı yeniden inşa et
                let bar = filterForm.querySelector('.filter-active-bar');
                const searchVal = (filterForm.querySelector('input[name="Search"]')?.value || '').trim();
                const total = activeFilters.Brand.size + activeFilters.Gender.size + activeFilters.Accord.size + (searchVal ? 1 : 0);

                if (total === 0) {
                    if (bar) bar.remove();
                    return;
                }

                if (!bar) {
                    bar = document.createElement('div');
                    bar.className = 'filter-active-bar';
                    filterForm.appendChild(bar);
                }

                const parts = ['<span class="text-muted small fw-medium me-1"><i class="bi bi-funnel-fill text-amber me-1"></i>Aktif:</span>'];
                const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
                if (searchVal) {
                    parts.push(`<span class="filter-active-pill" data-remove-filter data-key="Search" data-value="">"${esc(searchVal)}"<a href="javascript:void(0)"><i class="bi bi-x"></i></a></span>`);
                }
                activeFilters.Brand.forEach(v => parts.push(`<span class="filter-active-pill" data-remove-filter data-key="Brand" data-value="${esc(v)}">Marka: ${esc(v)}<a href="javascript:void(0)"><i class="bi bi-x"></i></a></span>`));
                activeFilters.Gender.forEach(v => parts.push(`<span class="filter-active-pill" data-remove-filter data-key="Gender" data-value="${esc(v)}">${esc(v)}<a href="javascript:void(0)"><i class="bi bi-x"></i></a></span>`));
                activeFilters.Accord.forEach(v => parts.push(`<span class="filter-active-pill" data-remove-filter data-key="Accord" data-value="${esc(v)}">Akor: ${esc(v)}<a href="javascript:void(0)"><i class="bi bi-x"></i></a></span>`));
                parts.push('<a href="javascript:void(0)" id="clearAllFilters" class="text-muted small text-decoration-none ms-auto"><i class="bi bi-arrow-counterclockwise"></i> Tümünü temizle</a>');

                bar.innerHTML = parts.join('');
            }

            // Search input — debounce 300ms
            const searchInput = filterForm.querySelector('input[name="Search"]');
            if (searchInput) {
                let searchTimer;
                searchInput.addEventListener('input', () => {
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(applyFilters, 300);
                });
            }
            filterForm.addEventListener('submit', (e) => {
                e.preventDefault();
                applyFilters();
            });

            // Sort select
            const sortSelect = document.getElementById('sortSelect');
            if (sortSelect) sortSelect.addEventListener('change', () => applyFilters());

            // Chip tıklaması → ilgili Set'e ekle/çıkar (TOGGLE), AJAX
            document.addEventListener('click', (e) => {
                const chip = e.target.closest('[data-filter][data-value]');
                if (!chip || !filterForm.contains(chip)) return;
                e.preventDefault();
                const k = chip.dataset.filter;
                const v = chip.dataset.value;
                if (!activeFilters[k]) return;
                if (activeFilters[k].has(v)) activeFilters[k].delete(v);
                else activeFilters[k].add(v);
                applyFilters();
            });

            // Aktif çubuktaki pill'lerden kaldır
            document.addEventListener('click', (e) => {
                const pill = e.target.closest('[data-remove-filter]');
                if (!pill) return;
                e.preventDefault();
                const k = pill.dataset.key;
                const v = pill.dataset.value;
                if (k === 'Search') {
                    if (searchInput) searchInput.value = '';
                } else if (activeFilters[k]) {
                    activeFilters[k].delete(v);
                }
                applyFilters();
            });

            // Tümünü temizle
            document.addEventListener('click', (e) => {
                if (!e.target.closest('#clearAllFilters')) return;
                e.preventDefault();
                MULTI_KEYS.forEach(k => activeFilters[k].clear());
                if (searchInput) searchInput.value = '';
                applyFilters();
            });

            // "Daha fazla göster / daha az" toggle (akor satırı)
            document.querySelectorAll('.filter-toggle-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const wrap = btn.closest('.filter-collapsible');
                    if (wrap) wrap.classList.toggle('expanded');
                });
            });

            // Marka dropdown: aç/kapa, arama
            (function () {
                const wrap = document.getElementById('brandDropdown');
                if (!wrap) return;
                const toggle = document.getElementById('brandDropdownToggle');
                const search = document.getElementById('brandSearchInput');
                const list = document.getElementById('brandDropdownList');
                const empty = document.getElementById('brandDropdownEmpty');

                toggle.addEventListener('click', (e) => {
                    if (e.target.closest('[data-clear-brand]')) return;
                    wrap.classList.toggle('open');
                    if (wrap.classList.contains('open')) setTimeout(() => search.focus(), 50);
                });

                document.addEventListener('click', (e) => {
                    if (!wrap.contains(e.target)) wrap.classList.remove('open');
                });

                search.addEventListener('input', () => {
                    const q = search.value.trim().toLowerCase();
                    let visible = 0;
                    list.querySelectorAll('.brand-dropdown-item').forEach(item => {
                        const name = (item.querySelector('.brand-name')?.textContent || '').toLowerCase();
                        const match = !q || name.includes(q);
                        item.style.display = match ? '' : 'none';
                        if (match) visible++;
                    });
                    empty.style.display = visible === 0 ? 'block' : 'none';
                });

                search.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape') wrap.classList.remove('open');
                });

                const clearBtn = wrap.querySelector('[data-clear-brand]');
                if (clearBtn) clearBtn.addEventListener('click', clearBrand);
            })();

            function clearBrand(e) {
                e.stopPropagation();
                e.preventDefault();
                activeFilters.Brand.clear();
                applyFilters();
            }
        })();
    </script>
}
