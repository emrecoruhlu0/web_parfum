@model WebParfum.ViewModels.PerfumeIndexViewModel

<div class="perfume-grid-meta text-muted small mb-2">
    @Model.TotalCount.ToString("N0") parfüm bulundu
</div>

<div class="row g-3">
    @foreach (var p in Model.Perfumes)
    {
        var placeholder = $"https://placehold.co/200x200/f8e8d0/d97706?text={Uri.EscapeDataString(p.Brand?.Length > 0 ? p.Brand.Substring(0, Math.Min(2, p.Brand.Length)) : "?")}";
        <div class="col-sm-6 col-lg-4 col-xl-3">
            <a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none">
                <div class="parfum-card card h-100">
                    <div class="perfume-card-img-wrap">
                        <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? placeholder : p.ImageUrl)"
                             alt="@p.Name"
                             class="perfume-card-img"
                             onerror="this.src='@placeholder'" />
                    </div>
                    <div class="card-body pt-2">
                        <h6 class="font-serif mb-0 text-truncate text-dark">@p.Name</h6>
                        <p class="text-muted small mb-2 text-truncate">@p.Brand</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                @if (!string.IsNullOrEmpty(p.Accord1))
                                {
                                    var s1 = AccordVisual.Get(p.Accord1);
                                    <span class="badge border me-1" style="font-size:.65rem;background:@(s1.Hex)20;color:@s1.Hex;border-color:@(s1.Hex)55 !important">
                                        <i class="bi @s1.Icon me-1"></i>@p.Accord1
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(p.Accord2))
                                {
                                    var s2 = AccordVisual.Get(p.Accord2);
                                    <span class="badge border" style="font-size:.65rem;background:@(s2.Hex)20;color:@s2.Hex;border-color:@(s2.Hex)55 !important">
                                        <i class="bi @s2.Icon me-1"></i>@p.Accord2
                                    </span>
                                }
                            </div>
                            <span class="badge bg-warning text-dark">
                                <i class="bi bi-star-fill"></i> @(p.RatingValue?.ToString("F1") ?? "-")
                            </span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

@if (!Model.Perfumes.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-search text-muted" style="font-size:2.5rem"></i>
        <p class="text-muted mt-2 mb-1">Bu kriterlere uyan parfüm bulunamadı.</p>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2">
            <i class="bi bi-arrow-counterclockwise me-1"></i> Filtreleri temizle
        </a>
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @{
                var prev = Math.Max(1, Model.Page - 1);
                var next = Math.Min(Model.TotalPages, Model.Page + 1);
                var startPage = Math.Max(1, Model.Page - 3);
                var endPage = Math.Min(Model.TotalPages, Model.Page + 3);
            }
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-all-route-data="@PageRoute(prev)">«</a>
            </li>
            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(Model.Page == i ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-all-route-data="@PageRoute(i)">@i</a>
                </li>
            }
            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-all-route-data="@PageRoute(next)">»</a>
            </li>
        </ul>
    </nav>
}

@functions {
    Dictionary<string, string?> PageRoute(int page)
    {
        return new Dictionary<string, string?>
        {
            ["Page"] = page.ToString(),
            ["Search"] = Model.Search,
            ["Brand"] = Model.Brand,
            ["Gender"] = Model.Gender,
            ["Accord"] = Model.Accord,
            ["Sort"] = Model.Sort,
        };
    }
}
