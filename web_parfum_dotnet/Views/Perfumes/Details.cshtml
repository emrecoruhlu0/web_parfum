@model WebParfum.ViewModels.PerfumeDetailViewModel
@using WebParfum.Helpers
@using WebParfum.Services

@{
    ViewData["Title"] = Model.Perfume.Name;
}

@functions {
    string RenderNoteChips(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return string.Empty;
        var sb = new System.Text.StringBuilder();
        foreach (var n in NoteVisual.Split(raw))
        {
            var s = NoteVisual.Get(n);
            sb.Append($"<span class=\"note-chip\" style=\"--note-color:{s.Hex}\">")
              .Append($"<i class=\"bi {s.Icon}\"></i>")
              .Append($"<span>{System.Net.WebUtility.HtmlEncode(n)}</span>")
              .Append("</span>");
        }
        return sb.ToString();
    }
}

<div class="row g-4">
    <div class="col-md-4">
        <div class="koku-card perfume-detail-panel overflow-hidden">
            @await Html.PartialAsync("_PerfumeImage", new PerfumeImageViewModel {
                ImageUrl = Model.Perfume.ImageUrl,
                Name = Model.Perfume.Name,
                Brand = Model.Perfume.Brand,
                Variant = "detail"
            })
            <div class="p-4">
                <h3 class="font-display mb-1">@Model.Perfume.Name</h3>
                <p class="text-muted">@Model.Perfume.Brand</p>

                <div class="d-flex flex-wrap gap-2 mb-3">
                    @if (Model.Perfume.Year.HasValue)
                    {
                        <span class="koku-badge">@Model.Perfume.Year</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Perfume.Gender))
                    {
                        <span class="koku-badge">@Model.Perfume.Gender</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Perfume.Country))
                    {
                        <span class="koku-badge">@Model.Perfume.Country</span>
                    }
                </div>

                <div class="mb-3">
                    <span class="koku-badge koku-badge-rating fs-6">
                        <i class="bi bi-star-fill"></i> @(Model.Perfume.RatingValue?.ToString("F2") ?? "-")
                    </span>
                    <small class="text-muted ms-2">
                        @(Model.Perfume.RatingCount ?? 0) oy
                    </small>
                </div>

                <div class="row text-center mb-3 g-0">
                    <div class="col detail-stat">
                        <strong data-like-count="@Model.Perfume.Id">@Model.LikeCount</strong>
                        <div><span>Beğeni</span></div>
                    </div>
                    <div class="col detail-stat">
                        <strong>@Model.CollectionCount</strong>
                        <div><span>Koleksiyon</span></div>
                    </div>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-grid gap-2">
                        <form asp-controller="Likes" asp-action="Toggle" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="perfumeId" value="@Model.Perfume.Id" />
                            <button type="submit" data-like-toggle="@Model.Perfume.Id"
                                    class="btn @(Model.IsLiked ? "btn-danger liked" : "btn-outline-danger") w-100">
                                <span data-like-icon>@(Model.IsLiked ? "♥" : "♡")</span>
                                <span data-like-label>@(Model.IsLiked ? "Beğenildi" : "Beğen")</span>
                            </button>
                        </form>

                        @{
                            var statusOptions = new[]
                            {
                                ("owned",    "Sahibim",       "bi-bag-check"),
                                ("tried",    "Denedim",       "bi-droplet-half"),
                                ("wishlist", "İstek Listem",  "bi-bookmark-heart"),
                            };
                        }
                        <div class="d-flex flex-column gap-2">
                            @foreach (var (key, label, icon) in statusOptions)
                            {
                                var active = Model.UserCollectionStatuses.Contains(key);
                                <form asp-controller="Collection" asp-action="Toggle" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="perfumeId" value="@Model.Perfume.Id" />
                                    <input type="hidden" name="status" value="@key" />
                                    <button type="submit"
                                            class="btn w-100 d-flex align-items-center justify-content-between @(active ? "btn-collection-active" : "btn-collection-inactive")">
                                        <span>
                                            <i class="bi @icon me-1"></i> @label
                                        </span>
                                        <span>@(active ? "✓" : "+")</span>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="koku-card p-4 mb-4">
                <h5 class="font-display mb-3">Notalar</h5>

                @if (!string.IsNullOrEmpty(Model.Perfume.TopNotes))
                {
                    <div class="note-row">
                        <div class="note-row-label">
                            <i class="bi bi-arrow-up-circle"></i>
                            <span>Üst Notalar</span>
                        </div>
                        <div class="note-chips">@Html.Raw(RenderNoteChips(Model.Perfume.TopNotes))</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Perfume.MiddleNotes))
                {
                    <div class="note-row">
                        <div class="note-row-label">
                            <i class="bi bi-record-circle"></i>
                            <span>Orta Notalar (Kalp)</span>
                        </div>
                        <div class="note-chips">@Html.Raw(RenderNoteChips(Model.Perfume.MiddleNotes))</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Perfume.BaseNotes))
                {
                    <div class="note-row">
                        <div class="note-row-label">
                            <i class="bi bi-arrow-down-circle"></i>
                            <span>Alt Notalar (Baz)</span>
                        </div>
                        <div class="note-chips">@Html.Raw(RenderNoteChips(Model.Perfume.BaseNotes))</div>
                    </div>
                }

                <hr />

                <h6 class="text-muted small mb-2">
                    <i class="bi bi-palette-fill me-1"></i> ANA AKORLAR
                </h6>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var accord in new[] { Model.Perfume.Accord1, Model.Perfume.Accord2,
                              Model.Perfume.Accord3, Model.Perfume.Accord4, Model.Perfume.Accord5 })
                    {
                        if (!string.IsNullOrEmpty(accord))
                        {
                            var s = AccordVisual.Get(accord);
                            <a asp-controller="Perfumes" asp-action="Index" asp-route-Accord="@accord"
                               class="accord-chip" style="background:@s.Hex; color:@s.TextHex"
                               title="@accord akoruna sahip parfümleri ara">
                                <i class="bi @s.Icon"></i>
                                <span>@accord</span>
                            </a>
                        }
                    }
                </div>
        </div>

        <div class="koku-card p-4">
                <h5 class="font-display mb-3">Yorumlar (@Model.Reviews.Count)</h5>

                @if (User.Identity?.IsAuthenticated == true && Model.UserReview == null)
                {
                    <form asp-controller="Reviews" asp-action="Create" method="post" class="mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="perfumeId" value="@Model.Perfume.Id" />
                        <div class="mb-2">
                            <label class="form-label small">Puan</label>
                            <select name="rating" class="form-select form-select-sm" style="max-width:120px;">
                                <option value="5">★★★★★ (5)</option>
                                <option value="4">★★★★ (4)</option>
                                <option value="3" selected>★★★ (3)</option>
                                <option value="2">★★ (2)</option>
                                <option value="1">★ (1)</option>
                            </select>
                        </div>
                        <textarea name="body" class="form-control mb-2" rows="2"
                                  placeholder="Yorumunuz..."></textarea>
                        <button type="submit" class="btn btn-koku btn-sm">
                            <i class="bi bi-pencil me-1"></i> Yorum yaz
                        </button>
                    </form>
                }

                @if (Model.Reviews.Any())
                {
                    @foreach (var r in Model.Reviews)
                    {
                        <div class="border-bottom py-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong>@r.User.Username</strong>
                                    <span class="star ms-2">
                                        @for (int i = 0; i < r.Rating; i++)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                    </span>
                                </div>
                                <small class="text-muted">@r.CreatedAt.ToString("dd.MM.yyyy")</small>
                            </div>
                            @if (!string.IsNullOrEmpty(r.Body))
                            {
                                <p class="mb-0 mt-1">@r.Body</p>
                            }
                            @if (Model.UserReview != null && r.Id == Model.UserReview.Id)
                            {
                                <form asp-controller="Reviews" asp-action="Delete" asp-route-id="@r.Id"
                                      method="post" class="mt-2">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Yorumunuzu silmek istiyor musunuz?');">
                                        <i class="bi bi-trash"></i> Sil
                                    </button>
                                </form>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="text-koku-muted mb-0">Henüz yorum yok. İlk yorumu sen yaz.</p>
                }
        </div>
    </div>
</div>

@if (Model.SimilarPerfumes.Any())
{
    <div class="mt-5">
        <h5 class="font-display mb-3">
            <i class="bi bi-stars me-1 text-warning"></i> Benzer Parfümler
        </h5>
        <div class="row g-3">
            @foreach (var reco in Model.SimilarPerfumes)
            {
                var p = reco.Perfume;
                var placeholder = $"https://placehold.co/200x200/f8e8d0/d97706?text={Uri.EscapeDataString(p.Brand?.Length > 0 ? p.Brand.Substring(0, Math.Min(2, p.Brand.Length)) : "?")}";
                <div class="col-6 col-md-4 col-lg-2">
                    <a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none">
                        <div class="parfum-card card h-100">
                            <div class="perfume-card-img-wrap">
                                <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? placeholder : p.ImageUrl)"
                                     alt="@p.Name"
                                     class="perfume-card-img"
                                     onerror="this.src='@placeholder'" />
                            </div>
                            <div class="card-body pt-2">
                                <h6 class="font-display mb-0 text-truncate text-dark">@p.Name</h6>
                                <p class="text-muted small mb-2 text-truncate">@p.Brand</p>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var accord in reco.MatchingAccords)
                                    {
                                        var s = AccordVisual.Get(accord);
                                        <span class="badge border" style="font-size:.6rem;background:@(s.Hex)20;color:@s.Hex;border-color:@(s.Hex)55 !important">
                                            <i class="bi @s.Icon me-1"></i>@accord
                                        </span>
                                    }
                                    @if (!reco.MatchingAccords.Any() && p.RatingValue.HasValue)
                                    {
                                        <span class="badge bg-warning text-dark" style="font-size:.6rem">
                                            <i class="bi bi-star-fill"></i> @p.RatingValue?.ToString("F1")
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
}
