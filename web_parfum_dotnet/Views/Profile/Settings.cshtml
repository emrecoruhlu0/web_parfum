@model WebParfum.ViewModels.EditProfileViewModel

@{
    ViewData["Title"] = "Profil Ayarları";
    ViewData["ActivePage"] = "Profile";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="d-flex align-items-center gap-2 mb-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h4 class="fw-bold mb-0"><i class="bi bi-gear me-2 text-amber"></i>Profil Ayarları</h4>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2">
                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
            </div>
        }

        <div class="parfum-card p-4">
            <form asp-action="Settings" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Username" class="form-label fw-medium"></label>
                    <input asp-for="Username" class="form-control" placeholder="kullanici_adi" autocomplete="username" />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                    <div class="form-text">Harf, rakam, alt çizgi (_) ve nokta (.) kullanabilirsin.</div>
                </div>

                <div class="mb-4">
                    <label asp-for="Bio" class="form-label fw-medium"></label>
                    <textarea asp-for="Bio" class="form-control" rows="3"
                              placeholder="Kendinden kısaca bahset..." maxlength="500"></textarea>
                    <span asp-validation-for="Bio" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-amber px-4 fw-semibold">
                        <i class="bi bi-check-lg me-1"></i>Kaydet
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
                </div>
            </form>
        </div>
    </div>
</div>
