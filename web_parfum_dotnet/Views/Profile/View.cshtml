@model WebParfum.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = $"@{Model.User.Username}";
    ViewData["ActivePage"] = "Profile";
    var activeSection = Model.Section ?? "collection";
}

@functions {
    string NormalizeName(string s) => string.IsNullOrEmpty(s)
        ? s
        : System.Globalization.CultureInfo.GetCultureInfo("tr-TR").TextInfo.ToTitleCase(s);
}

<div class="row g-4">
    <!-- Sol: Profil Kartı -->
    <div class="col-lg-3">
        <div class="parfum-card p-4 text-center mb-3">
            <div class="profile-avatar-lg mx-auto mb-3">
                @Model.User.Username.Substring(0, 1).ToUpper()
            </div>
            <h5 class="fw-bold mb-0">@Model.User.Username</h5>
            @if (!string.IsNullOrEmpty(Model.User.Bio))
            {
                <p class="text-muted small mt-2 mb-3">@Model.User.Bio</p>
            }
            else
            {
                <p class="text-muted small mt-2 mb-3 fst-italic">Henüz bio eklenmemiş.</p>
            }

            @if (Model.IsOwnProfile)
            {
                <span class="badge bg-amber-soft text-amber mb-2">
                    <i class="bi bi-person-check me-1"></i> Kendi Profilin
                </span>
            }
            else if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Follows" asp-action="Toggle" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="username" value="@Model.User.Username" />
                    <button type="submit"
                            class="btn btn-sm w-100 @(Model.IsFollowing ? "btn-outline-secondary" : "btn-amber")">
                        <i class="bi @(Model.IsFollowing ? "bi-person-dash" : "bi-person-plus") me-1"></i>
                        @(Model.IsFollowing ? "Takibi Bırak" : "Takip Et")
                    </button>
                </form>
            }
        </div>

        <div class="parfum-card p-3 mb-3">
            <div class="row text-center g-0">
                <div class="col-6 border-end py-2">
                    <div class="fw-bold fs-5">@Model.FollowersCount</div>
                    <div class="text-muted small">Takipçi</div>
                </div>
                <div class="col-6 py-2">
                    <div class="fw-bold fs-5">@Model.FollowingCount</div>
                    <div class="text-muted small">Takip</div>
                </div>
            </div>
        </div>

        <div class="parfum-card p-3">
            <div class="d-flex flex-column gap-2">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small"><i class="bi bi-collection me-2"></i>Koleksiyon</span>
                    <span class="badge bg-light text-dark">@Model.CollectionCount</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small"><i class="bi bi-chat-left-text me-2"></i>Yorumlar</span>
                    <span class="badge bg-light text-dark">@Model.ReviewsCount</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small"><i class="bi bi-calendar3 me-2"></i>Günlük Log</span>
                    <span class="badge bg-light text-dark">@Model.DailyLogCount</span>
                </div>
            </div>
        </div>

        @if (Model.TopNotes.Any() || Model.TopAccords.Any())
        {
            <div class="parfum-card p-3 mt-3">
                @if (Model.TopNotes.Any())
                {
                    <h6 class="fw-semibold mb-2 small text-uppercase text-muted">En Sık Notalar</h6>
                    <div class="d-flex flex-wrap gap-1 mb-3">
                        @foreach (var n in Model.TopNotes)
                        {
                            <span class="badge bg-amber-soft text-amber">@n.Name</span>
                        }
                    </div>
                }
                @if (Model.TopAccords.Any())
                {
                    <h6 class="fw-semibold mb-2 small text-uppercase text-muted">En Sık Akorlar</h6>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var a in Model.TopAccords)
                        {
                            <span class="badge bg-light text-dark">@a.Name</span>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- Sağ: İçerik -->
    <div class="col-lg-9">
        <!-- Sekmeler -->
        <div class="parfum-card mb-3">
            <nav class="nav nav-pills p-2 gap-1">
                <a class="nav-link @(activeSection == "collection" ? "active-tab" : "text-muted")"
                   asp-action="View" asp-route-username="@Model.User.Username" asp-route-section="collection">
                    <i class="bi bi-collection me-1"></i> Koleksiyon
                </a>
                <a class="nav-link @(activeSection == "logs" ? "active-tab" : "text-muted")"
                   asp-action="View" asp-route-username="@Model.User.Username" asp-route-section="logs">
                    <i class="bi bi-calendar3 me-1"></i> Günlük Loglar
                </a>
                <a class="nav-link @(activeSection == "reviews" ? "active-tab" : "text-muted")"
                   asp-action="View" asp-route-username="@Model.User.Username" asp-route-section="reviews">
                    <i class="bi bi-chat-left-text me-1"></i> Yorumlar
                </a>
                <a class="nav-link @(activeSection == "taste" ? "active-tab" : "text-muted")"
                   asp-action="View" asp-route-username="@Model.User.Username" asp-route-section="taste">
                    <i class="bi bi-stars me-1"></i> Koku Profili
                </a>
            </nav>
        </div>

        @if (activeSection == "collection")
        {
            <div class="mb-3 d-flex justify-content-center">
                <div class="subtab-buttons">
                    <a class="subtab-btn @(Model.CollectionStatus == "owned" ? "active" : "")"
                       asp-action="View" asp-route-username="@Model.User.Username"
                       asp-route-section="collection" asp-route-collectionStatus="owned">
                        <i class="bi bi-check-circle me-1"></i>Sahip
                        <span class="subtab-count">@Model.OwnedCount</span>
                    </a>
                    <a class="subtab-btn @(Model.CollectionStatus == "wishlist" ? "active" : "")"
                       asp-action="View" asp-route-username="@Model.User.Username"
                       asp-route-section="collection" asp-route-collectionStatus="wishlist">
                        <i class="bi bi-heart me-1"></i>İstek Listesi
                        <span class="subtab-count">@Model.WishlistCount</span>
                    </a>
                    <a class="subtab-btn @(Model.CollectionStatus == "tried" ? "active" : "")"
                       asp-action="View" asp-route-username="@Model.User.Username"
                       asp-route-section="collection" asp-route-collectionStatus="tried">
                        <i class="bi bi-droplet me-1"></i>Denedim
                        <span class="subtab-count">@Model.TriedCount</span>
                    </a>
                </div>
            </div>

            @if (!Model.CollectionItems.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-collection text-muted" style="font-size:2.5rem"></i>
                    <p class="text-muted mt-2">
                        @(Model.CollectionStatus switch
                        {
                            "wishlist" => "İstek listesinde parfüm yok.",
                            "tried" => "Denenmiş parfüm yok.",
                            _ => "Henüz koleksiyonda parfüm yok."
                        })
                    </p>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 g-3">
                    @foreach (var c in Model.CollectionItems)
                    {
                        var profPh = $"https://placehold.co/80x80/f8e8d0/d97706?text={Uri.EscapeDataString(c.Perfume.Brand?.Length > 0 ? c.Perfume.Brand.Substring(0, Math.Min(2, c.Perfume.Brand.Length)) : "?")}";
                        <div class="col">
                            <div class="parfum-card p-3 d-flex align-items-center gap-3">
                                <img src="@(string.IsNullOrEmpty(c.Perfume.ImageUrl) ? profPh : c.Perfume.ImageUrl)"
                                     alt="@c.Perfume.Name"
                                     class="flex-shrink-0"
                                     style="width:48px;height:48px;border-radius:10px;object-fit:cover;border:1px solid #f0ece6;"
                                     onerror="this.src='@profPh'" />
                                <div class="flex-grow-1 min-w-0">
                                    <a asp-controller="Perfumes" asp-action="Details" asp-route-id="@c.PerfumeId"
                                       class="fw-medium text-decoration-none text-dark d-block text-truncate">
                                        @c.Perfume.Name
                                    </a>
                                    <div class="text-muted small">@c.Perfume.Brand</div>
                                </div>
                                <div class="flex-shrink-0 text-end">
                                    @if (c.Status == "owned")
                                    {
                                        <span class="badge bg-success-soft text-success">Sahip</span>
                                        @if (c.BottleLevel > 0)
                                        {
                                            <div class="small text-muted mt-1">%@c.BottleLevel</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted">@c.Status</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else if (activeSection == "logs")
        {
            @if (!Model.RecentLogs.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar3 text-muted" style="font-size:2.5rem"></i>
                    <p class="text-muted mt-2">Henüz günlük log yok.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var d in Model.RecentLogs)
                    {
                        <div class="parfum-card p-3 d-flex align-items-center gap-3">
                            <div class="text-center flex-shrink-0" style="min-width:52px">
                                <div class="fw-bold text-amber" style="font-size:1.1rem">@d.Date.Day</div>
                                <div class="text-muted" style="font-size:0.7rem">@d.Date.ToString("MMM", new System.Globalization.CultureInfo("tr-TR")).ToUpper()</div>
                            </div>
                            <div class="flex-grow-1 min-w-0">
                                <a asp-controller="Perfumes" asp-action="Details" asp-route-id="@d.PerfumeId"
                                   class="fw-medium text-decoration-none text-dark">@d.Perfume.Name</a>
                                <div class="text-muted small">
                                    @if (d.Sprays > 0) { <span class="me-2"><i class="bi bi-droplet me-1"></i>@d.Sprays sıkım</span> }
                                    @if (!string.IsNullOrEmpty(d.Note)) { <em>@d.Note</em> }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else if (activeSection == "reviews")
        {
            @if (!Model.RecentReviews.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-chat-left-text text-muted" style="font-size:2.5rem"></i>
                    <p class="text-muted mt-2">Henüz yorum yok.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var r in Model.RecentReviews)
                    {
                        <div class="parfum-card p-3">
                            <div class="d-flex align-items-start justify-content-between gap-2">
                                <a asp-controller="Perfumes" asp-action="Details" asp-route-id="@r.PerfumeId"
                                   class="fw-medium text-decoration-none text-dark">@r.Perfume.Name</a>
                                <div class="flex-shrink-0">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= r.Rating ? "bi-star-fill star" : "bi-star star-empty") small"></i>
                                    }
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(r.Body))
                            {
                                <p class="text-muted small mb-0 mt-1 fst-italic">"@r.Body"</p>
                            }
                        </div>
                    }
                </div>
            }
        }
        else if (activeSection == "taste")
        {
            var tp = Model.TasteProfile;
            if (tp == null || tp.SignalCount == 0)
            {
                <div class="text-center py-5 parfum-card">
                    <i class="bi bi-stars text-muted" style="font-size:2.5rem"></i>
                    <h6 class="mt-3 fw-bold">Koku Profili Henüz Oluşmadı</h6>
                    <p class="text-muted small mb-0">
                        Parfümleri beğenerek, puanlayarak veya koleksiyonuna ekleyerek<br />
                        kişisel koku profilini oluşturmaya başla.
                    </p>
                </div>
            }
            else
            {
                var posAccords = tp.PositiveAccords.OrderByDescending(a => a.Value).Take(10).ToList();
                var negAccords = tp.NegativeAccords.OrderByDescending(a => a.Value).Take(8).ToList();
                var posNotes = tp.PositiveNotes.OrderByDescending(n => n.Value).Take(15).ToList();
                var posAccordMax = posAccords.Count > 0 ? posAccords.First().Value : 1;
                var negAccordMax = negAccords.Count > 0 ? negAccords.First().Value : 1;

                <div class="parfum-card p-4 mb-3">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:48px;height:48px;background:linear-gradient(135deg,#f59e0b,#d97706);color:white;">
                            <i class="bi bi-stars" style="font-size:1.4rem"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold">Koku Profili</h5>
                            <small class="text-muted">@tp.InteractedPerfumeCount parfüm etkileşiminden oluşturuldu</small>
                        </div>
                    </div>
                </div>

                @if (posAccords.Any())
                {
                    <div class="parfum-card p-4 mb-3">
                        <h6 class="fw-bold mb-3"><i class="bi bi-heart-fill text-success me-2"></i>Sevdiğin Akorlar</h6>
                        <div class="d-flex flex-column gap-2">
                            @foreach (var a in posAccords)
                            {
                                var pct = (int)Math.Round((a.Value / posAccordMax) * 100);
                                <div>
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="fw-medium">@NormalizeName(a.Key)</span>
                                        <span class="text-muted">@a.Value.ToString("0.0")</span>
                                    </div>
                                    <div class="progress" style="height:8px;background:#f3eee5">
                                        <div class="progress-bar" role="progressbar"
                                             style="width:@(pct)%;background:linear-gradient(90deg,#f59e0b,#d97706)"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (negAccords.Any())
                {
                    <div class="parfum-card p-4 mb-3">
                        <h6 class="fw-bold mb-3"><i class="bi bi-x-circle text-danger me-2"></i>Kaçındığın Akorlar</h6>
                        <div class="d-flex flex-column gap-2">
                            @foreach (var a in negAccords)
                            {
                                var pct = (int)Math.Round((a.Value / negAccordMax) * 100);
                                <div>
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="fw-medium">@NormalizeName(a.Key)</span>
                                        <span class="text-muted">@a.Value.ToString("0.0")</span>
                                    </div>
                                    <div class="progress" style="height:8px;background:#f3eee5">
                                        <div class="progress-bar bg-danger" role="progressbar"
                                             style="width:@(pct)%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (posNotes.Any())
                {
                    <div class="parfum-card p-4 mb-3">
                        <h6 class="fw-bold mb-3"><i class="bi bi-droplet-half text-amber me-2"></i>Favori Notalar</h6>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var n in posNotes)
                            {
                                <span class="badge bg-amber-soft text-amber" style="font-size:0.85rem;padding:0.5em 0.8em">
                                    @NormalizeName(n.Key)
                                </span>
                            }
                        </div>
                    </div>
                }

                @if (Model.IsOwnProfile && Model.Recommendations.Any())
                {
                    <div class="parfum-card p-4">
                        <h6 class="fw-bold mb-1"><i class="bi bi-magic text-amber me-2"></i>Sana Özel Öneriler</h6>
                        <p class="text-muted small mb-3">Koku profiline göre beğenebileceğin parfümler</p>
                        <div class="row row-cols-1 row-cols-md-2 g-3">
                            @foreach (var r in Model.Recommendations)
                            {
                                var recPh = $"https://placehold.co/80x80/f8e8d0/d97706?text={Uri.EscapeDataString(r.Perfume.Brand?.Length > 0 ? r.Perfume.Brand.Substring(0, Math.Min(2, r.Perfume.Brand.Length)) : "?")}";
                                <div class="col">
                                    <div class="parfum-card p-3 d-flex align-items-center gap-3" style="border:1px solid #f3eee5">
                                        <img src="@(string.IsNullOrEmpty(r.Perfume.ImageUrl) ? recPh : r.Perfume.ImageUrl)"
                                             alt="@r.Perfume.Name"
                                             class="flex-shrink-0"
                                             style="width:56px;height:56px;border-radius:10px;object-fit:cover;border:1px solid #f0ece6;"
                                             onerror="this.src='@recPh'" />
                                        <div class="flex-grow-1 min-w-0">
                                            <a asp-controller="Perfumes" asp-action="Details" asp-route-id="@r.Perfume.Id"
                                               class="fw-medium text-decoration-none text-dark d-block text-truncate">
                                                @r.Perfume.Name
                                            </a>
                                            <div class="text-muted small text-truncate">@r.Perfume.Brand</div>
                                            @if (r.MatchingAccords.Any())
                                            {
                                                <div class="mt-1">
                                                    @foreach (var ma in r.MatchingAccords)
                                                    {
                                                        <span class="badge bg-success-soft text-success me-1" style="font-size:0.65rem">@NormalizeName(ma)</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        <div class="flex-shrink-0 text-end">
                                            <div class="fw-bold text-amber">%@((int)Math.Round(r.Score * 100))</div>
                                            <div class="small text-muted">uyum</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        }
    </div>
</div>
