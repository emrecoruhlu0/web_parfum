# Bu dosyayı .env olarak kopyala ve değerleri kendi sunucuna göre düzenle.
# .env dosyası .gitignore'da olduğu için repo'ya gitmez.
#
# cp .env.example .env

# PostgreSQL parolası — production'da MUTLAKA güçlü bir parola gir
POSTGRES_PASSWORD=change_me_to_strong_password

# Opsiyonel — default değerler genelde yeterli
# POSTGRES_USER=postgres
# POSTGRES_DB=web_parfum

# App'in dışa açık olduğu port (Cloudflare proxy'lerse 80, doğrudan ulaşımsa 8080 vb.)
APP_PORT=8080

# PostgreSQL'i host'tan görmek istersen (sadece localhost'a expose).
# Eğer makinende zaten 5432'de bir PostgreSQL varsa 5433 gibi başka bir port seç.
DB_HOST_PORT=5432

# Production / Development
ASPNETCORE_ENVIRONMENT=Production
