# Bu dosyayı .env olarak kopyala ve değerleri kendi sunucuna göre düzenle.
# .env dosyası .gitignore'da olduğu için repo'ya gitmez.
#
# cp .env.example .env

# === ZORUNLU ===

# PostgreSQL parolası — production'da MUTLAKA güçlü bir parola gir
POSTGRES_PASSWORD=change_me_to_strong_password

# === LOKAL GELİŞTİRME (docker-compose.yml) ===

# App'in dışa açık olduğu port
APP_PORT=8080

# PostgreSQL'i host'tan görmek istersen (sadece localhost'a expose).
# Eğer makinende zaten 5432'de bir PostgreSQL varsa 5433 gibi başka bir port seç.
DB_HOST_PORT=5432

# Production / Development
ASPNETCORE_ENVIRONMENT=Production

# === PRODUCTION (docker-compose.prod.yml) ===
# Bu değerler sunucudaki mevcut Postgres container'ına bağlanmak için.

# Mevcut Postgres container'ının adı (Docker network içindeki hostname)
DB_HOST=postgres

# Mevcut Postgres container'ında zaten olan DB adı (varsayılan: postgres)
# Yeni bir DB açmak istiyorsan onun adını yaz (örn: web_parfum) ve önce o DB'yi
# manuel oluştur (DEPLOY.md'ye bak)
POSTGRES_DB=web_parfum

# Mevcut Postgres user (varsayılan: postgres)
POSTGRES_USER=postgres

# Postgres container içindeki port (genelde 5432)
DB_PORT=5432
